---
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={title} noindex>
  <article class="container legal">
    <a class="back mono" href="/">← Zur Startseite</a>
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: calc(46rem + 2 * var(--gutter));
    padding-block: clamp(3rem, 8vw, 5rem) clamp(4rem, 10vw, 7rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    margin-bottom: 2.5rem;
  }

  .prose {
    color: var(--ink-2);
  }

  .prose :global(h2) {
    margin: 2.75rem 0 0.9rem;
    font-size: 1.5rem;
    color: var(--ink);
  }

  .prose :global(h3) {
    margin: 1.75rem 0 0.6rem;
    font-size: 1.15rem;
    color: var(--ink);
  }

  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 1rem;
  }

  .prose :global(ul) {
    padding-left: 1.2rem;
  }

  .prose :global(li + li) {
    margin-top: 0.35rem;
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .prose :global(.todo) {
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
</style>
