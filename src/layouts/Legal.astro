---
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={title} noindex>
  <article class="container legal">
    <a class="back mono" href="/">← zur startseite</a>
    <h1 class="display">{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: clamp(8rem, 16vw, 11rem) clamp(5rem, 10vw, 8rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(3rem, 10vw, 8rem);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
    overflow-wrap: anywhere;
  }

  .prose {
    max-width: 44rem;
    color: var(--ink-2);
  }

  .prose :global(h2) {
    margin: 3rem 0 1rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 1rem;
  }

  .prose :global(ul) {
    padding-left: 1.2rem;
  }

  .prose :global(li + li) {
    margin-top: 0.35rem;
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .prose :global(.todo) {
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
</style>
