---
import { nav } from '../data/site';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const base = home ? '' : '/';
---

<header class="nav-wrap">
  <nav class="pill" aria-label="Hauptnavigation">
    <a class="brand" href={home ? '#top' : '/'}>luca wehrle<span aria-hidden="true">.</span></a>
    <span class="divider" aria-hidden="true"></span>
    <ul class="links">
      <li class="indicator" aria-hidden="true"></li>
      {
        nav.map((item) => (
          <li class={item.href === '#kontakt' ? 'only-mobile' : ''}>
            <a href={base + item.href} data-section={item.href.slice(1)}>
              <span class="long">{item.label}</span>
              <span class="short">{item.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="mode" href="/recruiter/" aria-label="Recruiter-Modus einschalten">
      <span class="switch" aria-hidden="true"><span></span></span>
      recruiter
    </a>
    <a class="talk" href={base + '#kontakt'} data-section="kontakt">
      let’s talk
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M7 17 17 7M9 7h8v8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
    </a>
  </nav>
</header>

<script>
  const pill = document.querySelector<HTMLElement>('.pill');
  const indicator = document.querySelector<HTMLElement>('.indicator');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.links a[data-section]')];
  const talk = document.querySelector<HTMLAnchorElement>('.talk');

  const setActive = (id: string | null) => {
    let target: HTMLAnchorElement | undefined;
    for (const link of links) {
      const match = link.dataset.section === id && link.offsetParent !== null;
      link.classList.toggle('active', match);
      if (match) {
        link.setAttribute('aria-current', 'true');
        target = link;
      } else link.removeAttribute('aria-current');
    }
    talk?.classList.toggle('active', id === 'kontakt');
    if (!indicator) return;
    if (target) {
      indicator.style.width = `${target.offsetWidth}px`;
      indicator.style.transform = `translateX(${target.offsetLeft}px)`;
      indicator.style.opacity = '1';
    } else {
      indicator.style.opacity = '0';
    }
  };

  // Aktiven Abschnitt erkennen (Scrollspy).
  const sections = links
    .map((link) => document.getElementById(link.dataset.section ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        let best: string | null = null;
        let ratio = 0;
        visible.forEach((r, id) => {
          if (r > ratio) {
            ratio = r;
            best = id;
          }
        });
        setActive(best);
      },
      { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.01, 0.2, 0.5, 1] },
    );
    sections.forEach((s) => observer.observe(s));
    window.addEventListener('resize', () => setActive(links.find((l) => l.classList.contains('active'))?.dataset.section ?? null));
  }

  // Leichter Schatten, sobald gescrollt wurde. Mobil verschwindet die Leiste beim Runterscrollen
  // (mehr Platz zum Lesen) und kommt beim Hochscrollen oder am Seitenende zurück.
  const wrap = document.querySelector<HTMLElement>('.nav-wrap');
  const mobile = window.matchMedia('(max-width: 720px)');
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    pill?.classList.toggle('scrolled', y > 24);
    const atEnd = window.innerHeight + y >= document.documentElement.scrollHeight - 80;
    const hide = mobile.matches && y > 160 && y > lastY + 4 && !atEnd;
    if (hide) wrap?.classList.add('hidden');
    else if (y < lastY - 4 || atEnd || y <= 160) wrap?.classList.remove('hidden');
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  // Fokus per Tastatur holt die Leiste immer zurück.
  wrap?.addEventListener('focusin', () => wrap.classList.remove('hidden'));
</script>

<style>
  .nav-wrap {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px));
    pointer-events: none;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 6px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 999px;
    background: rgb(18 18 20 / 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    pointer-events: auto;
    transition: box-shadow 0.3s ease;
  }

  .pill.scrolled {
    box-shadow: 0 12px 40px -12px rgb(0 0 0 / 0.6);
  }

  .brand {
    padding: 0.55rem 0.9rem 0.55rem 1rem;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand span {
    color: var(--accent);
  }

  .divider {
    width: 1px;
    height: 20px;
    background: rgb(255 255 255 / 0.14);
  }

  .links {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .indicator {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    opacity: 0;
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
  }

  .links a {
    position: relative;
    display: block;
    padding: 0.6rem 0.9rem;
    border-radius: 999px;
    color: rgb(242 240 235 / 0.62);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .links a:hover,
  .links a.active {
    color: var(--ink);
  }

  .short,
  .only-mobile {
    display: none;
  }

  .mode {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 0.35rem;
    padding: 0.6rem 0.8rem;
    border-radius: 999px;
    color: rgb(242 240 235 / 0.62);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .mode:hover {
    color: var(--ink);
  }

  .switch {
    position: relative;
    width: 26px;
    height: 15px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .switch span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: currentColor;
    transition: transform 0.25s ease;
  }

  .mode:hover .switch span {
    transform: translateX(3px);
  }

  .talk {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.35rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .talk svg {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease;
  }

  .talk:hover,
  .talk.active {
    background: var(--ink);
  }

  .talk:hover svg {
    transform: translate(2px, -2px);
  }

  /* Mobil: Leiste unten, gut mit dem Daumen erreichbar. */
  @media (max-width: 720px) {
    .nav-wrap {
      top: auto;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-wrap.hidden {
      transform: translateY(calc(100% + 24px + env(safe-area-inset-bottom, 0px)));
    }

    .pill {
      background: rgb(18 18 20 / 0.9);
    }

    .brand,
    .divider,
    .talk,
    .mode,
    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .only-mobile {
      display: block;
    }

    .links a {
      padding: 0.7rem 0.85rem;
    }
  }
</style>
