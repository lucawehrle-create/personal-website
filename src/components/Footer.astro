---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner mono">
    <p>© {year} {site.name.toLowerCase()}</p>
    <p>
      {site.location.toLowerCase()}, de<span class="clock" data-clock={site.timeZone}></span>
    </p>
    <nav aria-label="Rechtliches">
      <a href="/impressum/">impressum</a>
      <a href="/datenschutz/">datenschutz</a>
    </nav>
    <p>ohne cookies · ohne tracking</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--ink-3);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.75rem;
  }

  /* Trennstrich nur, wenn die Uhrzeit per JS gesetzt wurde */
  .clock:not(:empty)::before {
    content: ' — ';
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  a {
    display: inline-block;
    margin-block: -0.6rem;
    padding-block: 0.6rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    /* Platz für die Navigationsleiste unten */
    .site-footer {
      padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 5rem);
    }

    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
