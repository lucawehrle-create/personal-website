---
import RiseText from './RiseText.astro';
import { contact, site } from '../data/site';
---

<section id="kontakt" class="section contact" aria-labelledby="kontakt-title">
  <div class="container">
    <p class="label" data-reveal>kontakt</p>
    <h2 id="kontakt-title" class="display giant" data-reveal>
      <a href={`mailto:${site.email}`}><RiseText text={contact.heading} /></a>
    </h2>

    <div class="grid">
      <p class="text" data-reveal>{contact.text}</p>
      <div class="actions" data-reveal style="--delay: 0.1s">
        <p class="mono mail-label">e-mail</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="buttons">
          <button class="btn btn-accent copy" type="button" data-email={site.email} hidden>
            <span class="copy-text">e-mail kopieren</span>
          </button>
          <a class="btn" href={site.linkedin} target="_blank" rel="noopener">
            linkedin
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M7 17 17 7M9 7h8v8"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <p class="visually-hidden" aria-live="polite" id="copy-status"></p>
      </div>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('.copy');
  const status = document.getElementById('copy-status');

  if (button && navigator.clipboard) {
    button.hidden = false;
    const label = button.querySelector('.copy-text');
    let timer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        if (label) label.textContent = 'kopiert!';
        if (status) status.textContent = 'E-Mail-Adresse in die Zwischenablage kopiert.';
      } catch {
        // Ohne Zwischenablage: Adresse markieren, damit sie sich von Hand kopieren lässt.
        const mail = document.querySelector('.contact .mail');
        if (mail) window.getSelection()?.selectAllChildren(mail);
        if (label) label.textContent = 'adresse markiert';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = 'e-mail kopieren';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }

  .giant {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(3.4rem, 13.9vw, 12.75rem);
  }

  .giant a {
    display: inline-block;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 0.06em;
    background-position: 0 95%;
    background-repeat: no-repeat;
    transition:
      background-size 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease;
  }

  .giant a:hover {
    color: var(--accent);
    background-size: 100% 0.06em;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .text {
    max-width: 40ch;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--ink-2);
  }

  .mail-label {
    color: var(--ink-3);
  }

  .mail {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .mail:hover {
    color: var(--accent);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .copy[hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
