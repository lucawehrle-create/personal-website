---
// Werdegang als Zeitstrahl: eine Zeile pro Station mit Name und Zeitraum, Balken über den Jahren.
// Was heute noch läuft, ist orange; Abgeschlossenes grau. Ist nur das Jahr bekannt,
// läuft der Balken an dieser Seite weich aus, statt einen genauen Monat vorzutäuschen.
import { monthIndex, parsePeriod } from '../lib/period';

interface Props {
  groups: { title: string; rows: { label: string; period: string }[] }[];
}

const today = new Date();
const now = monthIndex(today) + 1;
// Ganze Jahre enden spätestens heute (z. B. „2025 – 2026“ im laufenden Jahr 2026).
const groups = Astro.props.groups.map((group) => ({
  ...group,
  rows: group.rows
    .map((row) => {
      const span = parsePeriod(row.period, today);
      return { ...row, span: { ...span, end: Math.min(span.end, now) } };
    })
    .sort((a, b) => a.span.start - b.span.start),
}));

const spans = groups.flatMap((group) => group.rows.map((row) => row.span));
const firstYear = Math.floor(Math.min(...spans.map((span) => span.start)) / 12);
const lastYear = Math.floor((Math.max(...spans.map((span) => span.end)) - 1) / 12);
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const domainStart = firstYear * 12;
const domain = years.length * 12;
const pct = (value: number) => `${(value * 100).toFixed(2)}%`;
const pos = (month: number) => (month - domainStart) / domain;

// Lage und weiches Auslaufen eines Balkens (Auslaufen: ein halbes Jahr, höchstens die halbe Länge)
const barStyle = (span: (typeof spans)[number]) => {
  const length = span.end - span.start;
  const fade = (exact: boolean) => (exact ? '0%' : pct(Math.min(6, length / 2) / length));
  return [
    `--l: ${pct(pos(span.start))}`,
    `--w: ${pct(length / domain)}`,
    `--fi: ${fade(span.exactStart)}`,
    `--fo: ${fade(span.exactEnd)}`,
  ].join('; ');
};
---

<div class="timeline" style={`--years: ${years.length}; --today: ${pct(pos(now))}`}>
  <div class="row axis" aria-hidden="true">
    <span></span>
    <ol class="years">
      {
        years.map((year) => (
          <li>
            <span class="full">{year}</span>
            <span class="short">’{String(year).slice(2)}</span>
          </li>
        ))
      }
    </ol>
  </div>
  {
    groups.map((group) => (
      <div class="group">
        <p class="row group-row">
          <span class="row-label mono">{group.title}</span>
          <span class="track" />
        </p>
        <ol class="rows">
          {group.rows.map((row) => (
            <li class="row">
              <span class="row-label">
                <span class="name">{row.label}</span>
                <span class="period mono">{row.period}</span>
              </span>
              <span class="track">
                <span class:list={['bar', { now: row.span.ongoing }]} style={barStyle(row.span)} />
              </span>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
  <p class="row today-row" aria-hidden="true">
    <span></span>
    <span class="track"><span class="today-label mono">heute</span></span>
  </p>
</div>

<style>
  .timeline {
    --label-w: 16rem;
    --grid: #e3e0d8;
    --bar: #8f8b82;
    --bar-now: var(--accent);
  }

  .row {
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr);
    align-items: center;
    margin: 0;
  }

  .years {
    display: grid;
    grid-template-columns: repeat(var(--years), minmax(0, 1fr));
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .years li {
    padding-left: 0.4rem;
  }

  .short {
    display: none;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Spur: Jahreslinien und Heute-Linie, über alle Zeilen hinweg bündig */
  .track {
    position: relative;
    display: block;
    height: 100%;
    min-height: 1.6rem;
    background: repeating-linear-gradient(to right, var(--grid) 0 1px, transparent 1px calc(100% / var(--years)));
  }

  .track::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--today);
    width: 1px;
    background: var(--bar-now);
  }

  .rows .row {
    min-height: 3rem;
  }

  .row-label {
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 1rem 0.45rem 0;
  }

  .name {
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .period {
    font-size: 0.68rem;
    color: var(--ink-3);
  }

  .group-row .row-label {
    padding-top: 0.9rem;
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .axis + .group .group-row .row-label {
    padding-top: 0.2rem;
  }

  .bar {
    position: absolute;
    top: 50%;
    left: var(--l);
    width: max(6px, var(--w));
    height: 14px;
    border-radius: 4px;
    background: var(--bar);
    transform: translateY(-50%);
    /* Ungenaue Grenzen laufen weich aus */
    mask-image: linear-gradient(
      to right,
      rgb(0 0 0 / 0.15) 0,
      #000 var(--fi),
      #000 calc(100% - var(--fo)),
      rgb(0 0 0 / 0.15) 100%
    );
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .bar.now {
    background: var(--bar-now);
  }

  /* Balken wachsen beim ersten Anzeigen von links */
  :global(.js) .timeline .bar {
    transform-origin: left center;
    transition: transform 0.9s cubic-bezier(0.6, 0, 0.2, 1);
  }

  :global(.js) :global([data-reveal]:not(.is-visible)) .timeline .bar {
    transform: translateY(-50%) scaleX(0);
  }

  .today-row .track {
    min-height: 1.6rem;
    background: none;
  }

  .today-row .track::after {
    bottom: auto;
    height: 0.3rem;
  }

  .today-label {
    position: absolute;
    top: 0.35rem;
    left: var(--today);
    padding-right: 0.35rem;
    transform: translateX(-100%);
    font-size: 0.7rem;
    color: var(--ink-2);
  }

  @media print {
    :global(.js) .timeline .bar {
      transform: translateY(-50%) !important;
    }

    .rows .row {
      min-height: 2.3rem;
    }

    .row-label {
      padding-block: 0.2rem;
    }
  }

  @media (max-width: 640px) {
    .timeline {
      --label-w: 0px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .axis > span:first-child,
    .today-row > span:first-child,
    .group-row .track {
      display: none;
    }

    .full {
      display: none;
    }

    .short {
      display: inline;
    }

    .years li {
      padding-left: 0.2rem;
    }

    .rows .row {
      min-height: 0;
    }

    /* Name und Zeitraum in einer Zeile über dem Balken */
    .row-label {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 0.5rem;
      padding: 0.5rem 0 0.2rem;
    }

    .name {
      font-size: 0.82rem;
    }

    .period {
      font-size: 0.72rem;
    }

    .track {
      min-height: 1.2rem;
    }

    .bar {
      height: 10px;
    }

    .group-row .row-label {
      padding-top: 1rem;
    }
  }
</style>
