---
import DotField from './DotField.astro';
import { hero, site } from '../data/site';

const [first, last] = site.name.toLowerCase().split(' ');
let index = 0;
const letters = (word: string) => [...word].map((ch) => ({ ch, i: index++ }));
const lines = [letters(first), letters(last)];
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <DotField />
  <div class="container inner">
    <div class="top-row mono">
      <span class="label">{hero.label}</span>
      <span class="where">
        {site.location}, DE<span class="clock" data-clock={site.timeZone}></span>
      </span>
    </div>

    <div class="cols">
      {
        hero.columns.map((col, i) => (
          <div class="col" data-reveal style={`--delay: ${0.5 + i * 0.12}s`}>
            <p class="col-label mono">{col.label}</p>
            <p class="col-text">{col.text}</p>
          </div>
        ))
      }
    </div>

    <h1 id="hero-title" class="name display" aria-label={site.name}>
      {
        lines.map((line) => (
          <span class="line" aria-hidden="true">
            {line.map(({ ch, i }) => (
              <span class="ch" style={`--i: ${i}`}>
                {ch}
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <div class="bottom-row mono">
      <span>{hero.tagline}</span>
      <a class="scroll" href="#projekte">
        scroll
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M12 5v14m0 0-6-6m6 6 6-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vh, 4rem);
    padding-top: clamp(6.5rem, 14vh, 9rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .top-row,
  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--ink-3);
  }

  /* Trennstrich nur, wenn die Uhrzeit per JS gesetzt wurde */
  .clock:not(:empty)::before {
    content: ' — ';
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    max-width: 1120px;
  }

  .col-label {
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }

  .col-text {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .name {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    font-size: clamp(3.6rem, 13.9vw, 12.75rem);
    color: var(--ink);
  }

  .line {
    display: block;
    overflow: hidden;
    padding-block: 0.08em 0.04em;
    margin-block: -0.08em -0.04em;
  }

  .ch {
    display: inline-block;
  }

  :global(.js) .ch {
    transform: translateY(105%);
    animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.15s + var(--i) * 45ms);
  }

  @keyframes rise {
    to {
      transform: none;
    }
  }

  .scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .scroll:hover {
    color: var(--accent);
  }

  .scroll svg {
    width: 14px;
    height: 14px;
    animation: nudge 2.2s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .cols .col:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .inner {
      padding-top: calc(env(safe-area-inset-top, 0px) + 2rem);
      padding-bottom: 6.5rem;
    }

    .name {
      flex-direction: column;
      font-size: clamp(3.6rem, 23vw, 9rem);
    }
  }
</style>
