---
import { hero, site } from '../data/site';

// "*wort*" in der Headline wird zum markierten Wort mit Unterstreichung.
const [before, highlight, after] = hero.headline.split('*');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow mono" data-reveal>
      {hero.eyebrow.map((item) => <span class="crumb">{item}</span>)}
    </p>

    <h1 id="hero-title" class="headline" data-reveal style="--delay: 0.08s">
      <span class="name">{site.name}</span>
      {' '}
      <span class="rest">
        {before}
        {
          highlight && (
            <span class="highlight">
              {highlight}
              <svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true">
                <path d="M3 17 C 52 6, 96 21, 148 12 S 246 5, 297 13" />
              </svg>
            </span>
          )
        }
        {after}
      </span>
    </h1>

    <div class="below">
      <div class="intro" data-reveal style="--delay: 0.16s">
        <p class="lead">{hero.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#projekte">
            Projekte ansehen
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 5v14m0 0-6-6m6 6 6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </a>
          <a class="btn btn-ghost" href="#kontakt">Kontakt aufnehmen</a>
        </div>
      </div>

      <dl class="spec" data-reveal style="--delay: 0.24s">
        <div class="spec-head mono">
          <span>Spec Sheet</span>
          <span aria-hidden="true">v{new Date().getFullYear()}</span>
        </div>
        {
          hero.facts.map((fact) => (
            <div class="spec-row">
              <dt class="mono">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul class="stats" data-reveal style="--delay: 0.3s">
      {
        hero.stats.map((stat) => (
          <li>
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3.5rem, 8vw, 6rem);
    isolation: isolate;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 75%);
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--ink-3);
  }

  .crumb + .crumb::before {
    content: '/';
    margin-right: 1.1rem;
    color: var(--ink-3);
    opacity: 0.5;
  }

  .headline {
    max-width: 17ch;
    font-size: clamp(2.5rem, 7.2vw, 6.1rem);
    font-weight: 640;
    line-height: 0.98;
    letter-spacing: -0.035em;
    hyphens: manual;
  }

  .name {
    color: var(--ink);
  }

  .rest {
    color: var(--ink-3);
  }

  .highlight {
    position: relative;
    display: inline-block;
    color: var(--ink);
  }

  .highlight svg {
    position: absolute;
    left: -2%;
    bottom: -0.12em;
    width: 104%;
    height: 0.32em;
    overflow: visible;
  }

  .highlight path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 0;
    vector-effect: non-scaling-stroke;
  }

  :global(.js) .headline .highlight path {
    stroke-dashoffset: 320;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.6, 0, 0.2, 1) 0.7s;
  }

  :global(.js) .headline.is-visible .highlight path {
    stroke-dashoffset: 0;
  }

  .below {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: 2.5rem 4rem;
    align-items: start;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .lead {
    max-width: 34ch;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .spec {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
  }

  .spec-head {
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px dashed var(--line);
    color: var(--ink-3);
    font-size: 0.7rem;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.75rem 1.1rem;
    align-items: baseline;
  }

  .spec-row + .spec-row {
    border-top: 1px solid var(--line);
  }

  .spec dt {
    color: var(--ink-3);
    font-size: 0.7rem;
  }

  .spec dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.4rem 1.5rem 0 0;
  }

  .stats li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .below {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .crumb + .crumb::before {
      display: none;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .stats li,
    .stats li + li {
      flex-direction: row;
      align-items: baseline;
      gap: 0.9rem;
      padding: 1rem 0;
      border-left: 0;
    }

    .stats li + li {
      border-top: 1px solid var(--line);
    }

    .stat-value {
      min-width: 4.6ch;
      font-size: 2rem;
    }
  }
</style>
