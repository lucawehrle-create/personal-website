---
import DotField from './DotField.astro';
import { hero, site } from '../data/site';

const [first, last] = site.name.toLowerCase().split(' ');
let index = 0;
const letters = (word: string) => [...word].map((ch) => ({ ch, i: index++ }));
const lines = [letters(first), letters(last)];
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <DotField portrait />
  <div class="portrait-slot desk" data-portrait-slot aria-hidden="true"></div>
  <div class="container inner">
    <div class="top-row mono">
      <span class="label">{hero.label}</span>
      <span class="where">
        {site.location}, DE<span class="clock" data-clock={site.timeZone}></span>
      </span>
      <a class="mode-mobile" href="/recruiter/">recruiter-modus →</a>
    </div>

    <div class="cols">
      {
        hero.columns.map((col, i) => (
          <div class="col" data-reveal style={`--delay: ${0.5 + i * 0.12}s`}>
            <p class="col-label mono">{col.label}</p>
            <p class="col-text">{col.text}</p>
          </div>
        ))
      }
    </div>

    <div class="portrait-slot mob" data-portrait-slot data-align="center" aria-hidden="true"></div>

    <h1 id="hero-title" class="name display" aria-label={site.name}>
      {
        lines.map((line) => (
          <span class="line" aria-hidden="true">
            {line.map(({ ch, i }) => (
              <span class="ch" style={`--i: ${i}`}>
                {ch}
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <div class="bottom-row mono">
      <span>{hero.tagline}</span>
      <!-- Terminal nur am Desktop (mit Tastatur); mobil ausgeblendet -->
      <button class="term-hint mono" type="button" data-terminal-open>
        drück <kbd>/</kbd> für das terminal
      </button>
      <a class="scroll" href="#projekte">
        scroll
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M12 5v14m0 0-6-6m6 6 6-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vh, 4rem);
    padding-top: clamp(6.5rem, 14vh, 9rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .top-row,
  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--ink-3);
  }

  /* Trennstrich nur, wenn die Uhrzeit per JS gesetzt wurde */
  .clock:not(:empty)::before {
    content: ' — ';
  }

  /* Rechts zeichnet das Punktraster das Porträt in diesen Bereich. */
  .portrait-slot.desk {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 54%;
    height: 86%;
    pointer-events: none;
  }

  .portrait-slot.mob {
    display: none;
  }

  .cols {
    display: grid;
    gap: 1.75rem;
    max-width: 420px;
  }

  .col-label {
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }

  .col-text {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .name {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    font-size: clamp(3.6rem, 13.9vw, 12.75rem);
    color: var(--ink);
  }

  .line {
    display: block;
    overflow: hidden;
    padding-block: 0.08em 0.04em;
    margin-block: -0.08em -0.04em;
  }

  .ch {
    display: inline-block;
  }

  :global(.js) .ch {
    transform: translateY(105%);
    animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.15s + var(--i) * 45ms);
  }

  @keyframes rise {
    to {
      transform: none;
    }
  }

  .term-hint {
    padding: 0.35rem 0.7rem;
    border: 1px dashed var(--line);
    border-radius: 999px;
    background: none;
    color: var(--ink-3);
    font: inherit;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .term-hint:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  .term-hint kbd {
    padding: 0 0.35em;
    border: 1px solid var(--ink-3);
    border-radius: 4px;
    font: inherit;
    color: var(--accent);
  }

  .mode-mobile {
    display: none;
  }

  .scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block: -0.6rem;
    padding-block: 0.6rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .scroll:hover {
    color: var(--accent);
  }

  .scroll svg {
    width: 14px;
    height: 14px;
    animation: nudge 2.2s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 860px) {
    .cols .col:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .inner {
      gap: 1.25rem;
      padding-top: calc(env(safe-area-inset-top, 0px) + 1.5rem);
      padding-bottom: 6.5rem;
    }

    .name {
      flex-direction: column;
      margin-top: 0;
      font-size: clamp(3.6rem, 23vw, 9rem);
    }

    .cols .col:nth-child(n + 2),
    .portrait-slot.desk {
      display: none;
    }

    .bottom-row {
      flex-wrap: wrap;
    }

    .bottom-row > span:first-child {
      flex-basis: 100%;
    }

    .term-hint,
    .where {
      display: none;
    }

    .mode-mobile {
      display: inline;
      padding: 0.3rem 0.65rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--ink-2);
      text-decoration: none;
    }

    .portrait-slot.mob {
      display: block;
      flex: 1;
      min-height: 30svh;
      margin-block: 0 -1.5rem;
    }
  }
</style>
