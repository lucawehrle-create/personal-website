---
import type { Project } from '../data/site';

interface Props {
  type: Project['visual'];
}

const { type } = Astro.props;

// 21-Tage-Raster für Mindfulscreen: 15 Tage geschafft, Tag 16 ist heute.
const days = Array.from({ length: 21 }, (_, i) => ({
  x: 262 + (i % 7) * 30,
  y: 104 + Math.floor(i / 7) * 30,
  state: i < 15 ? 'done' : i === 15 ? 'today' : 'open',
}));
---

{
  type === 'potato' && (
    <svg class="visual potato" viewBox="0 0 480 300" role="img" aria-label="Illustration: eine beschriftete Kartoffel">
      <ellipse class="shadow" cx="248" cy="248" rx="138" ry="14" />
      <g class="spud" transform="rotate(-7 248 160)">
        <path
          class="skin"
          d="M112 158 C 100 100, 168 70, 244 78 C 322 86, 384 96, 388 154 C 392 214, 334 242, 252 238 C 172 234, 122 210, 112 158 Z"
        />
        <ellipse class="eye" cx="158" cy="118" rx="5" ry="3" />
        <ellipse class="eye" cx="300" cy="100" rx="4" ry="2.5" />
        <ellipse class="eye" cx="346" cy="196" rx="5" ry="3" />
        <ellipse class="eye" cx="190" cy="214" rx="4" ry="2.5" />
        <circle class="speck" cx="132" cy="168" r="2" />
        <circle class="speck" cx="226" cy="98" r="1.6" />
        <circle class="speck" cx="364" cy="140" r="1.8" />
        <circle class="speck" cx="270" cy="222" r="1.6" />
        <text class="message" x="250" y="170" text-anchor="middle">Alles Gute!</text>
      </g>
      <g class="tag" transform="rotate(8 392 52)">
        <rect x="330" y="32" width="126" height="40" rx="8" />
        <text x="393" y="57" text-anchor="middle">No. 1.000+</text>
      </g>
      <path class="spark" d="M70 70 v18 M61 79 h18" />
      <path class="spark" d="M418 214 v14 M411 221 h14" />
      <path class="spark" d="M96 236 v10 M91 241 h10" />
    </svg>
  )
}

{
  type === 'focus' && (
    <svg class="visual focus" viewBox="0 0 480 300" role="img" aria-label="Illustration: Fokus-Timer und 21-Tage-Fortschritt">
      <circle class="track" cx="138" cy="150" r="80" />
      <circle class="progress" cx="138" cy="150" r="80" transform="rotate(-90 138 150)" />
      <text class="time" x="138" y="156" text-anchor="middle">25:00</text>
      <text class="label" x="138" y="182" text-anchor="middle">DEEP WORK</text>

      <text class="label" x="262" y="84">TAG 16 / 21</text>
      {days.map((day) => (
        <rect class={`day ${day.state}`} x={day.x} y={day.y} width="22" height="22" rx="6" />
      ))}
      <text class="label muted" x="262" y="218">SCREEN TIME ↓ · FOKUS ↑</text>
    </svg>
  )
}

<style>
  .visual {
    width: 100%;
    height: 100%;
  }

  /* Kartoffel */
  .shadow {
    fill: rgb(0 0 0 / 0.12);
  }

  .skin {
    fill: var(--potato);
    stroke: var(--potato-dark);
    stroke-width: 2;
  }

  .eye {
    fill: var(--potato-dark);
  }

  .speck {
    fill: var(--potato-dark);
    opacity: 0.45;
  }

  .message {
    fill: var(--potato-ink);
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tag rect {
    fill: var(--bg-elev);
    stroke: var(--line);
  }

  .tag text {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .spark {
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .spud {
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-origin: 248px 160px;
  }

  /* Fokus */
  .track,
  .progress {
    fill: none;
    stroke-width: 14;
  }

  .track {
    stroke: var(--focus-track);
  }

  .progress {
    stroke: var(--focus);
    stroke-linecap: round;
    stroke-dasharray: 503;
    stroke-dashoffset: 151;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.6, 0, 0.2, 1) 0.3s;
  }

  :global(.js) :global([data-reveal]:not(.is-visible)) .progress {
    stroke-dashoffset: 503;
  }

  .time {
    fill: var(--focus-ink);
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .label {
    fill: var(--focus);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .label.muted {
    fill: var(--focus-ink);
    opacity: 0.6;
  }

  .day {
    fill: var(--focus-track);
  }

  .day.done {
    fill: var(--focus);
  }

  .day.today {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
  }
</style>
