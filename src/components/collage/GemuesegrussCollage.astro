---
import { Image } from 'astro:assets';
import Bento from './Bento.astro';
import produkt from '../../assets/gemuesegruss/produktfoto.jpg';
import { caseStudy, months } from '../../data/gemuesegruss';
import stift from '../../assets/gemuesegruss/tiktok-beschriften-stift.jpg';

const areas = `"hero hero trend views" "hero hero stift views" "orders orders best noad"`;
const mobileAreas = `"hero hero trend" "hero hero best"`;
const bestDay = caseStudy.bestDay;
// Mini-Verlauf der Shop-Bestellungen; der stärkste Monat ist orange.
const maxOrders = Math.max(...months.map((month) => month.orders));
const peak = months.find((month) => month.orders === maxOrders)!;
---

<Bento areas={areas} mobileAreas={mobileAreas}>
  <!-- Das Produkt -->
  <div class="tile" style="grid-area: hero; --i: 0">
    <Image class="fill" src={produkt} alt="" widths={[480, 900]} sizes="(max-width: 960px) 90vw, 380px" />
    <span class="chip">kartoffel mit botschaft</span>
  </div>

  <!-- Bestellungen pro Monat im Shop -->
  <div class="tile t-cream pad trend" style="grid-area: trend; --i: 1">
    <p class="t-label">bestellungen im shop</p>
    <div class="cols push" aria-hidden="true">
      {months.map((month, i) => <span class:list={{ peak: month === peak }} style={`--h: ${month.orders / maxOrders}; --d: ${i}`} />)}
    </div>
    <p class="trend-note"><strong>{peak.orders}</strong> im {peak.label}</p>
  </div>

  <!-- Reichweite -->
  <div class="tile t-dark pad views m-hide" style="grid-area: views; --i: 2">
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"></path></svg>
    </span>
    <p class="t-big push top">1,1 Mio.</p>
    <p class="t-label">aufrufe für ein reel</p>
    <hr />
    <p class="t-big total">2,8 Mio.+</p>
    <p class="t-label">aufrufe insgesamt · tiktok & instagram</p>
  </div>

  <!-- Handarbeit -->
  <div class="tile m-hide" style="grid-area: stift; --i: 3">
    <Image class="fill" src={stift} alt="" widths={[400]} sizes="180px" />
    <span class="chip">von hand beschriftet</span>
  </div>

  <!-- Bestellungen -->
  <div class="tile t-accent pad orders m-hide" style="grid-area: orders; --i: 4">
    <div class="push orders-row">
      <p class="t-big">1.000+</p>
      <p class="t-text">Kartoffeln mit Botschaft verschickt.</p>
    </div>
    <p class="note" aria-hidden="true">
      <span class="bag">
        <svg viewBox="0 0 24 24"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" fill="currentColor"></path></svg>
      </span>
      <span><strong>Bestellung #1052</strong><br />13,49 € · GemüseGruß</span>
    </p>
  </div>

  <!-- Der stärkste Tag laut Shopify -->
  <div class="tile t-dark pad best" style="grid-area: best; --i: 5">
    <p class="t-label">bester tag</p>
    <p class="t-big push">{bestDay.orders}</p>
    <p class="t-text">Bestellungen an einem Tag</p>
  </div>

  <!-- Werbebudget -->
  <div class="tile t-cream pad noad m-hide" style="grid-area: noad; --i: 6">
    <p class="t-big">0 €</p>
    <p class="t-text push">Werbebudget.<br />100 % organisch.</p>
  </div>
</Bento>

<style>
  .best .t-big {
    font-size: calc(var(--u) * 0.42);
  }

  .best .t-text {
    margin-top: calc(var(--u) * 0.03);
    font-size: max(10px, calc(var(--u) * 0.075));
    font-weight: 600;
  }

  .cols {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 42%;
    border-bottom: 1px solid #c9c5bc;
  }

  .cols span {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px 2px 0 0;
    background: #77746e;
    transform-origin: bottom;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.4s + var(--d) * 35ms);
  }

  .cols .peak {
    background: #e8470f;
  }

  :global(.js) :global([data-reveal]:not(.is-visible)) .cols span {
    transform: scaleY(0);
  }

  .trend-note {
    margin-top: calc(var(--u) * 0.05);
    font-size: max(10px, calc(var(--u) * 0.068));
    line-height: 1.25;
  }

  .trend-note strong {
    font-weight: 800;
  }

  .play {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 0.26);
    height: calc(var(--u) * 0.26);
    border-radius: 50%;
    background: #ff5b1f;
    color: #0d0d0e;
  }

  .play svg {
    width: 52%;
    margin-left: 8%;
  }

  .views .top {
    font-size: calc(var(--u) * 0.27);
  }

  .views .t-label {
    margin-top: calc(var(--u) * 0.04);
  }

  .views hr {
    width: 100%;
    margin: calc(var(--u) * 0.1) 0;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .views .total {
    font-size: calc(var(--u) * 0.17);
    color: #ff6a2b;
  }

  .orders .t-big {
    font-size: calc(var(--u) * 0.42);
  }

  .orders-row {
    display: flex;
    align-items: flex-end;
    gap: calc(var(--u) * 0.08);
  }

  .orders .t-text {
    max-width: 9em;
    padding-bottom: calc(var(--u) * 0.03);
    font-weight: 600;
  }

  .note {
    position: absolute;
    right: var(--pad);
    top: var(--pad);
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.05);
    padding: calc(var(--u) * 0.04) calc(var(--u) * 0.07) calc(var(--u) * 0.04) calc(var(--u) * 0.04);
    border-radius: calc(var(--u) * 0.07);
    background: rgb(255 255 255 / 0.92);
    color: #111112;
    font-size: calc(var(--u) * 0.055);
    line-height: 1.3;
    box-shadow: 0 6px 18px rgb(120 30 0 / 0.25);
    transform: rotate(2deg);
  }

  .bag {
    display: grid;
    place-items: center;
    width: calc(var(--u) * 0.15);
    height: calc(var(--u) * 0.15);
    border-radius: calc(var(--u) * 0.035);
    background: #95bf47;
    color: #fff;
  }

  .bag svg {
    width: 60%;
  }

  .noad .t-big {
    font-size: calc(var(--u) * 0.4);
  }

  .noad .t-text {
    font-weight: 600;
  }
</style>
