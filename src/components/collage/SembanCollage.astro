---
import { Image } from 'astro:assets';
import Bento from './Bento.astro';
import feed from '../../assets/collage/semban-feed.jpg';
import lernfoto from '../../assets/collage/semban-lernfoto.jpg';

const areas = `"feed feed logo head" "feed feed timer head" "photo store claim claim"`;
const mobileAreas = `"feed feed" "logo head" "timer head"`;
---

<Bento areas={areas} mobileAreas={mobileAreas}>
  <!-- App-Feed (echter Screenshot von semban.de) -->
  <div class="tile feed" style="grid-area: feed; --i: 0">
    <p class="t-label pad">app · iphone, ipad & web</p>
    <div class="screen">
      <Image src={feed} alt="" widths={[360, 720]} sizes="(max-width: 960px) 45vw, 260px" />
    </div>
  </div>

  <!-- Logo -->
  <div class="tile t-paper pad logo" style="grid-area: logo; --i: 1">
    <svg class="mark" viewBox="0 0 72 72" aria-hidden="true">
      <rect x="4" y="4" width="64" height="64" rx="15" fill="#fc5200"></rect>
      <rect x="18.5" y="31" width="7" height="20" rx="3.5" fill="#fff"></rect>
      <rect x="31" y="23.5" width="7" height="27.5" rx="3.5" fill="#fff"></rect>
      <rect x="43.5" y="38.5" width="7" height="12.5" rx="3.5" fill="#fff"></rect>
      <rect x="43.5" y="26.5" width="7" height="7.5" rx="1.8" fill="#fff"></rect>
      <path d="M45.6 28.6l2.8 3.3m0-3.3-2.8 3.3" stroke="#fc5200" stroke-width="1.2" stroke-linecap="round"></path>
    </svg>
    <p class="name">SemBan</p>
  </div>

  <!-- Claim -->
  <div class="tile t-dark pad head" style="grid-area: head; --i: 2">
    <p class="t-label">your social study companion</p>
    <p class="t-big push">Lernen ist besser mit <span>Freunden.</span></p>
  </div>

  <!-- Fokus-Timer -->
  <div class="tile t-cream pad timer" style="grid-area: timer; --i: 3">
    <p class="t-label">fokus-timer</p>
    <svg class="ring push" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="42" fill="none" stroke="rgb(252 82 0 / 0.16)" stroke-width="8"></circle>
      <circle class="progress" cx="50" cy="50" r="42" fill="none" stroke="#fc5200" stroke-width="8" stroke-linecap="round" pathLength="100" transform="rotate(-90 50 50)"></circle>
      <text x="50" y="56" text-anchor="middle">25:00</text>
    </svg>
  </div>

  <!-- Lernfoto aus dem Feed -->
  <div class="tile m-hide" style="grid-area: photo; --i: 4">
    <Image class="fill" src={lernfoto} alt="" widths={[320, 640]} sizes="(max-width: 960px) 25vw, 180px" />
    <span class="chip">1 h 30 min</span>
  </div>

  <!-- App Store -->
  <div class="tile t-accent pad store m-hide" style="grid-area: store; --i: 5">
    <p class="t-label">iphone & ipad</p>
    <p class="t-big push">App Store <span aria-hidden="true">↗</span></p>
  </div>

  <!-- Positionierung -->
  <div class="tile t-cream pad claim m-hide" style="grid-area: claim; --i: 6">
    <p class="t-label">kostenlos · werbefrei</p>
    <p class="t-big push">Strava fürs Lernen.</p>
    <p class="applause" aria-hidden="true"><span>👏</span> 7 haben applaudiert</p>
  </div>
</Bento>

<style>
  .feed {
    --t-bg: linear-gradient(160deg, #ff7a2e 0%, #fc5200 55%, #d84400 100%);
    background: var(--t-bg);
    color: #fff;
  }

  .feed .t-label {
    opacity: 0.9;
  }

  .screen {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 56%;
    transform: translateX(-50%) rotate(-3deg);
    border-radius: calc(var(--u) * 0.07);
    overflow: hidden;
    box-shadow:
      0 calc(var(--u) * 0.1) calc(var(--u) * 0.25) rgb(120 30 0 / 0.45),
      0 0 0 calc(var(--u) * 0.02) rgb(255 255 255 / 0.9);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .feed:hover .screen {
    transform: translateX(-50%) rotate(0deg) translateY(-3%);
  }

  .logo {
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 0.06);
  }

  .mark {
    width: 52%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo:hover .mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .name {
    font-weight: 800;
    font-size: calc(var(--u) * 0.13);
    letter-spacing: -0.03em;
  }

  .head .t-big {
    font-size: calc(var(--u) * 0.135);
    line-height: 1;
  }

  .head span {
    color: #ff6a2b;
  }

  .ring {
    width: 74%;
    align-self: center;
    margin-bottom: calc(var(--u) * -0.02);
  }

  .ring text {
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 600;
    fill: #111112;
  }

  .progress {
    stroke-dasharray: 100;
    stroke-dashoffset: 28;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.4s;
  }

  :global(.js) :global([data-reveal]:not(.is-visible)) .progress {
    stroke-dashoffset: 100;
  }

  .store .t-big {
    font-size: calc(var(--u) * 0.2);
  }

  .claim .t-big {
    font-size: calc(var(--u) * 0.25);
  }

  .applause {
    position: absolute;
    right: var(--pad);
    top: var(--pad);
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.04);
    padding: calc(var(--u) * 0.03) calc(var(--u) * 0.07) calc(var(--u) * 0.03) calc(var(--u) * 0.04);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
    font-size: calc(var(--u) * 0.06);
    font-weight: 600;
  }

  .applause span {
    font-size: 1.3em;
  }
</style>
