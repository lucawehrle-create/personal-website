---
import { Image } from 'astro:assets';
import Bento from './Bento.astro';
import screenStart from '../../assets/collage/semban-start.webp';
import screenStatistik from '../../assets/collage/semban-web-statistik.webp';
import screenWeb from '../../assets/collage/semban-web-gruppen.webp';
import maskottchen from '../../assets/collage/semban-maskottchen.webp';
import icon from '../../assets/logos/semban.svg';

// Echte App-Screenshots von semban.de
const areas = `"feed feed logo head" "feed feed timer head" "photo store web web"`;
const mobileAreas = `"feed feed logo" "feed feed photo"`;
---

<Bento areas={areas} mobileAreas={mobileAreas}>
  <!-- iPad mit Statistik, davor das iPhone mit dem Lern-Feed -->
  <div class="tile feed" style="grid-area: feed; --i: 0">
    <p class="t-label pad">app · iphone, ipad & web</p>
    <div class="tablet">
      <Image src={screenStatistik} alt="" widths={[480, 960]} sizes="(max-width: 960px) 70vw, 340px" />
    </div>
    <div class="phone">
      <Image src={screenStart} alt="" widths={[300, 600]} sizes="(max-width: 960px) 40vw, 200px" />
    </div>
  </div>

  <!-- Logo -->
  <div class="tile t-paper pad logo" style="grid-area: logo; --i: 1">
    <img class="mark" src={icon.src} alt="" width="72" height="72" />
    <p class="name">SemBan</p>
  </div>

  <!-- Claim -->
  <div class="tile t-dark pad head m-hide" style="grid-area: head; --i: 2">
    <p class="t-label">strava fürs lernen · kostenlos & werbefrei</p>
    <p class="t-big push">Lernen ist besser mit <span>Freunden.</span></p>
  </div>

  <!-- Fokus-Timer -->
  <div class="tile t-cream pad timer m-hide" style="grid-area: timer; --i: 3">
    <p class="t-label">fokus-timer</p>
    <svg class="ring push" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="42" fill="none" stroke="rgb(252 82 0 / 0.16)" stroke-width="8"></circle>
      <circle class="progress" cx="50" cy="50" r="42" fill="none" stroke="#fc5200" stroke-width="8" stroke-linecap="round" pathLength="100" transform="rotate(-90 50 50)"></circle>
      <text x="50" y="56" text-anchor="middle">25:00</text>
    </svg>
  </div>

  <!-- Maskottchen -->
  <div class="tile mascot" style="grid-area: photo; --i: 4">
    <p class="t-label pad m-hide">maskottchen</p>
    <Image class="fox" src={maskottchen} alt="" widths={[256, 512]} sizes="(max-width: 960px) 30vw, 180px" />
  </div>

  <!-- App Store -->
  <div class="tile t-accent pad store m-hide" style="grid-area: store; --i: 5">
    <p class="t-label">iphone & ipad</p>
    <p class="t-big push">App Store <span aria-hidden="true">↗</span></p>
  </div>

  <!-- Web-App: Lerngruppen mit Wochenziel und Bestenliste -->
  <div class="tile web m-hide" style="grid-area: web; --i: 6">
    <p class="t-label pad">web · lerngruppen & bestenliste</p>
    <div class="browser">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <Image src={screenWeb} alt="" widths={[480, 960]} sizes="(max-width: 960px) 60vw, 380px" />
    </div>
  </div>
</Bento>

<style>
  .feed {
    --t-bg: linear-gradient(160deg, #ff7a2e 0%, #fc5200 55%, #d84400 100%);
    background: var(--t-bg);
    color: #fff;
  }

  .feed .t-label {
    opacity: 0.9;
  }

  /* iPad hinten links, iPhone vorne rechts – beide unten angeschnitten */
  .tablet {
    position: absolute;
    left: -6%;
    top: 26%;
    width: 84%;
    padding: calc(var(--u) * 0.025);
    border-radius: calc(var(--u) * 0.06);
    background: #111112;
    box-shadow: 0 calc(var(--u) * 0.08) calc(var(--u) * 0.22) rgb(120 30 0 / 0.4);
    transform: rotate(-5deg);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tablet img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--u) * 0.035);
  }

  .phone {
    position: absolute;
    right: 6%;
    top: 34%;
    width: 40%;
    border-radius: calc(var(--u) * 0.07);
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 calc(var(--u) * 0.1) calc(var(--u) * 0.25) rgb(120 30 0 / 0.5),
      0 0 0 calc(var(--u) * 0.018) #111112;
    transform: rotate(4deg);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .phone img {
    display: block;
    width: 100%;
    height: auto;
  }

  .feed:hover .tablet {
    transform: rotate(-7deg) translate(-3%, -3%);
  }

  .feed:hover .phone {
    transform: rotate(6deg) translate(2%, -6%);
  }

  .logo {
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 0.06);
  }

  .mark {
    width: 52%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo:hover .mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .name {
    font-weight: 800;
    font-size: calc(var(--u) * 0.13);
    letter-spacing: -0.03em;
  }

  .head .t-big {
    font-size: calc(var(--u) * 0.135);
    line-height: 1;
  }

  .head span {
    color: #ff6a2b;
  }

  .ring {
    width: 74%;
    align-self: center;
    margin-bottom: calc(var(--u) * -0.02);
  }

  .ring text {
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 600;
    fill: #111112;
  }

  .progress {
    stroke-dasharray: 100;
    stroke-dashoffset: 28;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.4s;
  }

  :global(.js) :global([data-reveal]:not(.is-visible)) .progress {
    stroke-dashoffset: 100;
  }

  .mascot {
    --t-bg: radial-gradient(circle at 50% 70%, #ffe6d6 0%, #ffc9a8 100%);
    --t-fg: #5a2200;
    background: var(--t-bg);
  }

  /* Der Fuchs sitzt unten in der Kachel und winkt beim Hover */
  .fox {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: 80%;
    height: auto;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mascot:hover .fox {
    transform: translateX(-50%) rotate(-6deg) scale(1.05);
  }

  .store .t-big {
    font-size: calc(var(--u) * 0.2);
  }

  /* Web-App im Browserfenster, unten angeschnitten */
  .web {
    --t-bg: linear-gradient(160deg, #2a2a2d, #19191b);
    background: var(--t-bg);
  }

  .browser {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 30%;
    border-radius: calc(var(--u) * 0.05) calc(var(--u) * 0.05) 0 0;
    overflow: hidden;
    background: #efede8;
    box-shadow: 0 calc(var(--u) * 0.08) calc(var(--u) * 0.2) rgb(0 0 0 / 0.5);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dots {
    display: flex;
    gap: calc(var(--u) * 0.02);
    padding: calc(var(--u) * 0.03) calc(var(--u) * 0.04);
    background: #e3e0d8;
  }

  .dots i {
    width: calc(var(--u) * 0.028);
    height: calc(var(--u) * 0.028);
    border-radius: 50%;
    background: #c9c5bc;
  }

  .browser img {
    display: block;
    width: 100%;
    height: auto;
  }

  .web:hover .browser {
    transform: translateY(-5%);
  }
</style>
