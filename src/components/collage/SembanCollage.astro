---
import { Image } from 'astro:assets';
import Bento from './Bento.astro';
import appStart from '../../assets/collage/semban/app-start.webp';
import appLernen from '../../assets/collage/semban/app-lernen.webp';
import appPlan from '../../assets/collage/semban/app-plan.webp';
import appStatistik from '../../assets/collage/semban/app-statistik.webp';
import widgetPlan from '../../assets/collage/semban/widget-stundenplan.webp';
import widgetStats from '../../assets/collage/semban/widget-statistik.webp';
import maskottchen from '../../assets/collage/semban-maskottchen.webp';
import icon from '../../assets/logos/semban.svg';

// Echte Screenshots aus der SemBan-App (Namen anderer Nutzer:innen unkenntlich gemacht)
const areas = `"feed feed logo head" "feed feed sched head" "photo store stats stats"`;
const mobileAreas = `"feed feed logo" "feed feed photo"`;
const phones = [
  { src: appLernen, pos: 'left' },
  { src: appPlan, pos: 'right' },
  { src: appStart, pos: 'center' },
];
---

<Bento areas={areas} mobileAreas={mobileAreas}>
  <!-- Drei iPhones: Bestenliste, Stundenplan und vorne der Lern-Feed -->
  <div class="tile feed" style="grid-area: feed; --i: 0">
    <p class="t-label pad">app · iphone, ipad & web</p>
    {
      phones.map((phone) => (
        <div class:list={['phone', phone.pos]}>
          <Image src={phone.src} alt="" widths={[280, 560]} sizes="(max-width: 960px) 30vw, 170px" />
        </div>
      ))
    }
  </div>

  <!-- Logo -->
  <div class="tile t-paper pad logo" style="grid-area: logo; --i: 1">
    <img class="mark" src={icon.src} alt="" width="72" height="72" />
    <p class="name">SemBan</p>
  </div>

  <!-- Claim mit Statistik-Ansicht -->
  <div class="tile t-dark pad head m-hide" style="grid-area: head; --i: 2">
    <p class="t-label">strava fürs lernen · kostenlos & werbefrei</p>
    <p class="t-big">Lernen ist besser mit <span>Freunden.</span></p>
    <div class="phone tall">
      <Image src={appStatistik} alt="" widths={[280, 560]} sizes="(max-width: 960px) 30vw, 150px" />
    </div>
  </div>

  <!-- Widget: Stundenplan der Woche -->
  <div class="tile widget-tile m-hide" style="grid-area: sched; --i: 3">
    <Image class="widget" src={widgetPlan} alt="" widths={[400, 800]} sizes="(max-width: 960px) 30vw, 180px" />
  </div>

  <!-- Maskottchen -->
  <div class="tile mascot" style="grid-area: photo; --i: 4">
    <p class="t-label pad m-hide">maskottchen</p>
    <Image class="fox" src={maskottchen} alt="" widths={[256, 512]} sizes="(max-width: 960px) 30vw, 180px" />
  </div>

  <!-- App Store -->
  <div class="tile t-accent pad store m-hide" style="grid-area: store; --i: 5">
    <p class="t-label">iphone & ipad</p>
    <p class="t-big push">App Store <span aria-hidden="true">↗</span></p>
  </div>

  <!-- Widget: Lernzeit heute, diese Woche und im Monat -->
  <div class="tile widget-tile m-hide" style="grid-area: stats; --i: 6">
    <Image class="widget" src={widgetStats} alt="" widths={[400, 800]} sizes="(max-width: 960px) 60vw, 370px" />
  </div>
</Bento>

<style>
  .feed {
    --t-bg: linear-gradient(160deg, #ff7a2e 0%, #fc5200 55%, #d84400 100%);
    background: var(--t-bg);
    color: #fff;
  }

  .feed .t-label {
    opacity: 0.9;
  }

  /* iPhones: zwei schräg dahinter, eines vorne – unten angeschnitten */
  .phone {
    position: absolute;
    top: 24%;
    width: 36%;
    overflow: hidden;
    border-radius: calc(var(--u) * 0.075);
    background: #111112;
    box-shadow:
      0 calc(var(--u) * 0.1) calc(var(--u) * 0.25) rgb(80 20 0 / 0.5),
      0 0 0 calc(var(--u) * 0.018) #111112;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .phone img {
    display: block;
    width: 100%;
    height: auto;
  }

  .phone.left {
    left: 5%;
    top: 30%;
    transform: rotate(-9deg);
  }

  .phone.right {
    right: 5%;
    top: 30%;
    transform: rotate(9deg);
  }

  .phone.center {
    left: 50%;
    width: 40%;
    z-index: 1;
    transform: translateX(-50%);
  }

  .feed:hover .phone.left {
    transform: rotate(-12deg) translate(-6%, -2%);
  }

  .feed:hover .phone.right {
    transform: rotate(12deg) translate(6%, -2%);
  }

  .feed:hover .phone.center {
    transform: translateX(-50%) translateY(-5%);
  }

  /* Hohe Kachel: Claim oben, Statistik-Ansicht ragt von unten herein */
  .phone.tall {
    top: auto;
    bottom: -38%;
    left: 50%;
    width: 72%;
    transform: translateX(-50%);
  }

  .head:hover .phone.tall {
    transform: translateX(-50%) translateY(-6%);
  }

  /* Widgets wie auf dem Homescreen */
  .widget-tile {
    --t-bg: #0b0b0c;
    background: var(--t-bg);
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
  }

  .widget {
    width: 88%;
    height: auto;
    border-radius: calc(var(--u) * 0.08);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .widget-tile:hover .widget {
    transform: scale(1.03);
  }

  .logo {
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 0.06);
  }

  .mark {
    width: 52%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo:hover .mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .name {
    font-weight: 800;
    font-size: calc(var(--u) * 0.13);
    letter-spacing: -0.03em;
  }

  .head .t-big {
    font-size: calc(var(--u) * 0.135);
    line-height: 1;
  }

  .head span {
    color: #ff6a2b;
  }

  .mascot {
    --t-bg: radial-gradient(circle at 50% 70%, #ffe6d6 0%, #ffc9a8 100%);
    --t-fg: #5a2200;
    background: var(--t-bg);
  }

  /* Der Fuchs sitzt unten in der Kachel und winkt beim Hover */
  .fox {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: 80%;
    height: auto;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mascot:hover .fox {
    transform: translateX(-50%) rotate(-6deg) scale(1.05);
  }

  .store .t-big {
    font-size: calc(var(--u) * 0.2);
  }

</style>
