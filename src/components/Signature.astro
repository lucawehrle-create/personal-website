---
// Unterschrift, die sich Buchstabe für Buchstabe „schreibt“, sobald sie ins Bild scrollt.
import { signature } from '../data/signature';
import { site } from '../data/site';
---

<svg class="signature" viewBox={signature.viewBox} role="img" aria-label={`Unterschrift: ${site.name}`}>
  {signature.paths.map((d, i) => <path d={d} pathLength="1" style={`--i: ${i}`} />)}
</svg>

<style>
  .signature {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  path {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  :global(.js) path {
    fill: transparent;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.js) :global([data-reveal].is-visible) path {
    animation:
      write 0.55s cubic-bezier(0.6, 0, 0.4, 1) forwards,
      ink 0.5s ease forwards;
    animation-delay: calc(0.3s + var(--i) * 0.12s), calc(0.7s + var(--i) * 0.12s);
  }

  @keyframes write {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes ink {
    to {
      fill: var(--accent);
    }
  }
</style>
