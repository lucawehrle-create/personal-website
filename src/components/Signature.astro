---
// Echte Unterschrift, die sich beim Hereinscrollen von links nach rechts „schreibt“.
import { signature } from '../data/signature';
import { site } from '../data/site';
---

<svg class="signature" viewBox={signature.viewBox} role="img" aria-label={`Unterschrift: ${site.name}`}>
  <path d={signature.d} fill-rule="evenodd"></path>
</svg>

<style>
  .signature {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  path {
    fill: var(--accent);
  }

  /* Schreibbewegung: die Unterschrift wird von links nach rechts freigelegt */
  :global(.js) .signature {
    clip-path: inset(-10% 100% -10% 0);
  }

  :global(.js) :global([data-reveal].is-visible) .signature {
    clip-path: inset(-10% 0 -10% 0);
    transition: clip-path 1.8s cubic-bezier(0.45, 0.05, 0.35, 1) 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .signature {
      clip-path: none;
    }
  }
</style>
