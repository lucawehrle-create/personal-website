---
interface Props {
  index: string;
  label: string;
  id: string;
}

const { index, label, id } = Astro.props;
---

<div class="section-heading" data-reveal>
  <p class="mono label"><span class="section-index">{index}</span>{label}</p>
  <h2 id={id}><slot /></h2>
</div>

<style>
  .section-heading {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
    color: var(--ink-3);
  }

  h2 {
    max-width: 20ch;
    font-size: clamp(2.1rem, 5.2vw, 4rem);
  }
</style>
