---
import { about } from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="ueber" class="section paper about" aria-labelledby="ueber-title">
  <div class="container">
    <div class="intro">
      <div class="head" data-reveal>
        <p class="label">über mich</p>
        <h2 id="ueber-title">{about.heading}</h2>
      </div>
      <div class="text" data-reveal style="--delay: 0.1s">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="principles-wrap">
      <p class="label" data-reveal>prinzipien</p>
      <ol class="principles">
        {
          about.principles.map((principle, i) => (
            <li data-reveal style={`--delay: ${i * 0.08}s`}>
              <span class="mono num">{pad(i + 1)}</span>
              <p class="rule">
                <span>{principle.better}</span>
                <span class="gt" aria-hidden="true">
                  &gt;
                </span>
                <span class="visually-hidden">statt</span>
                <span class="over">{principle.over}</span>
              </p>
              <p class="why">{principle.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="terminal" data-reveal>
      <figcaption class="term-bar mono">
        <span>~/luca</span>
        <span>anomalies.log</span>
      </figcaption>
      <div class="term-body mono">
        <p class="cmd"><span class="prompt">$</span> luca --list-anomalies</p>
        <div class="entries">
          {
            about.anomalies.map((item, i) => (
              <div class="entry">
                <p class="dim">
                  [{pad(i + 1)}] {item.label}
                </p>
                <p class="entry-title">{item.title}</p>
                <p class="entry-text">{item.text}</p>
              </div>
            ))
          }
        </div>
        <p class="status">
          {about.status.map((line) => <span>{line}</span>)}
        </p>
        <p class="cmd"><span class="prompt">$</span> <span class="caret" aria-hidden="true"></span></p>
      </div>
    </figure>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem clamp(3rem, 6vw, 6rem);
    align-items: end;
  }

  .head .label {
    margin-bottom: 1.5rem;
  }

  h2 {
    font-stretch: 112%;
    font-size: clamp(2.6rem, 6.2vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .text {
    display: grid;
    gap: 1.2rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--ink-2);
  }

  .text p:first-child {
    color: var(--ink);
  }

  .principles-wrap {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .principles {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .principles li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: baseline;
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .num {
    color: var(--ink-3);
  }

  .rule {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.3em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.6rem, 3.4vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .gt {
    color: var(--accent);
  }

  .over {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 0.06em;
  }

  .why {
    color: var(--ink-2);
  }

  /* Terminal-Ausgabe als Hommage an die „System Anomalies“ der alten Seite */
  .terminal {
    margin: clamp(4rem, 9vw, 7rem) 0 0;
    border-radius: 16px;
    background: #111112;
    color: #e9e7e1;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.45);
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid #262628;
    color: #8a8780;
  }

  .term-body {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .prompt {
    color: #ff5b1f;
  }

  .entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 3rem;
  }

  .dim {
    color: #8a8780;
  }

  .entry-title {
    margin: 0.2rem 0 0.4rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #f2f0eb;
  }

  .entry-text {
    color: #b9b6af;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    color: #ff5b1f;
  }

  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: #e9e7e1;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .intro,
    .entries {
      grid-template-columns: 1fr;
    }

    .principles li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .why {
      grid-column: 2;
    }
  }
</style>
