---
import { about } from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="ueber" class="section paper about" aria-labelledby="ueber-title">
  <div class="container">
    <div class="intro">
      <div class="head" data-reveal>
        <p class="label">über mich</p>
        <h2 id="ueber-title">{about.heading}</h2>
      </div>
      <div class="text" data-reveal style="--delay: 0.1s">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="interests">
          <p class="label">abseits vom laptop</p>
          <ul>
            {about.interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="principles-wrap">
      <p class="label" data-reveal>prinzipien</p>
      <ol class="principles">
        {
          about.principles.map((principle, i) => (
            <li data-reveal style={`--delay: ${i * 0.08}s`}>
              <span class="mono num">{pad(i + 1)}</span>
              <p class="rule">
                <span>{principle.better}</span>
                <span class="gt" aria-hidden="true">
                  &gt;
                </span>
                <span class="visually-hidden">statt</span>
                <span class="over">{principle.over}</span>
              </p>
              <p class="why">{principle.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem clamp(3rem, 6vw, 6rem);
    align-items: end;
  }

  .head .label {
    margin-bottom: 1.5rem;
  }

  h2 {
    font-stretch: 112%;
    font-size: clamp(2.6rem, 6.2vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .text {
    display: grid;
    gap: 1.2rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--ink-2);
  }

  .text > p:first-child {
    color: var(--ink);
  }

  .interests {
    margin-top: 0.75rem;
  }

  .interests ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .interests li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .principles-wrap {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .principles {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .principles li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: baseline;
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .num {
    color: var(--ink-3);
  }

  .rule {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.3em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.6rem, 3.4vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .gt {
    color: var(--accent);
  }

  .over {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 0.06em;
  }

  .why {
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .principles li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .why {
      grid-column: 2;
    }
  }
</style>
