---
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/site';
---

<section id="ueber" class="section" aria-labelledby="ueber-title">
  <div class="container">
    <SectionHeading index="01" label="Über mich" id="ueber-title">{about.heading}</SectionHeading>

    <div class="layout">
      <div class="text" data-reveal>
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ol class="principles">
        {
          about.principles.map((principle, i) => (
            <li data-reveal style={`--delay: ${i * 0.08}s`}>
              <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
              <p class="rule">
                {principle.better}
                <span class="gt" aria-hidden="true">
                  &gt;
                </span>
                <span class="visually-hidden">statt</span>
                <span class="over">{principle.over}</span>
              </p>
              <p class="why">{principle.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="facts">
      {
        about.funFacts.map((fact, i) => (
          <article class="fact" data-reveal style={`--delay: ${i * 0.1}s`}>
            <p class="mono fact-label">{fact.label}</p>
            <h3>{fact.title}</h3>
            <p class="muted">{fact.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 3rem clamp(3rem, 7vw, 6rem);
    align-items: start;
  }

  .text {
    display: grid;
    gap: 1.25rem;
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .text p:first-child {
    color: var(--ink);
  }

  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .principles li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .num {
    grid-row: span 2;
    padding-top: 0.55rem;
    color: var(--ink-3);
  }

  .rule {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .gt {
    margin-inline: 0.35em;
    color: var(--accent);
  }

  .over {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(in srgb, var(--ink-3) 60%, transparent);
  }

  .why {
    margin-top: 0.35rem;
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }

  .fact {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .fact-label {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 0.7rem;
  }

  .fact h3 {
    margin-bottom: 0.6rem;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
  }

  @media (max-width: 860px) {
    .layout,
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
