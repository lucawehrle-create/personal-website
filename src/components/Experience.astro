---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';

const groups = [
  { title: 'Erfahrung', items: experience.work },
  { title: 'Ausbildung', items: experience.education },
];
---

<section id="werdegang" class="section" aria-labelledby="werdegang-title">
  <div class="container">
    <SectionHeading index="03" label="Werdegang" id="werdegang-title">Studium, Praxis und Werkzeugkasten.</SectionHeading>

    <div class="columns">
      {
        groups.map((group, i) => (
          <div class="group" data-reveal style={`--delay: ${i * 0.1}s`}>
            <h3 class="mono group-title">{group.title}</h3>
            <ul class="entries">
              {group.items.map((item) => (
                <li>
                  <p class="org">{item.org}</p>
                  <p class="role">
                    {item.title}
                    {item.detail && <span class="detail"> · {item.detail}</span>}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="group toolbox" data-reveal style="--delay: 0.2s">
        <h3 class="mono group-title">Toolbox</h3>
        <ul class="chips">
          {experience.toolbox.map((tool) => <li class="chip">{tool}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(2rem, 4vw, 3.5rem);
  }

  .group-title {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entries li {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .org {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .role {
    margin-top: 0.25rem;
    color: var(--ink-2);
  }

  .detail {
    color: var(--ink-3);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 1.2rem 0 0;
    list-style: none;
  }

  @media (max-width: 960px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .toolbox {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
