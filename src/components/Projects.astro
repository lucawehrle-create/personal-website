---
import { Image } from 'astro:assets';
import RiseText from './RiseText.astro';
import { projects } from '../data/site';

const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, '');
const pad = (n: number) => String(n).padStart(2, '0');

// Laufende Projekte zuerst, danach die abgeschlossenen Experimente (fortlaufend nummeriert).
const numbered = projects.map((project, index) => ({ project, index }));
const groups = [
  { label: '', items: numbered.filter(({ project }) => project.status === 'live') },
  { label: 'abgeschlossene experimente', items: numbered.filter(({ project }) => project.status === 'abgeschlossen') },
].filter((group) => group.items.length);
---

<section id="projekte" class="section projects" aria-labelledby="projekte-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="label">ausgewählte arbeiten</p>
      <h2 id="projekte-title" class="display"><RiseText text="projekte" /></h2>
    </div>

    {
      groups.map((group) => (
        <div class="group">
          {group.label && (
            <p class="label group-label" data-reveal>
              {group.label}
            </p>
          )}
          <ol class="list">
            {group.items.map(({ project, index }) => (
              <li class:list={['project', { done: project.status === 'abgeschlossen' }]} data-reveal>
                <div class="info">
                  <p class="num" aria-hidden="true">
                    {pad(index + 1)}
                  </p>
                  <h3 class="title">{project.name}</h3>
                  <p class="mono category">
                    <span class:list={['status', project.status]}>{project.status}</span>
                    {project.category}
                  </p>
                  <ol class="experiment" aria-label="Experiment">
                    <li>
                      <span class="mono step">hypothese</span>
                      <p>{project.experiment.hypothesis}</p>
                    </li>
                    <li>
                      <span class="mono step">test</span>
                      <p>{project.experiment.test}</p>
                    </li>
                    <li class="result">
                      <span class="mono step">ergebnis</span>
                      <p>{project.experiment.result}</p>
                    </li>
                    {project.experiment.learning && (
                      <li>
                        <span class="mono step">learning</span>
                        <p>{project.experiment.learning}</p>
                      </li>
                    )}
                    {project.experiment.next && (
                      <li>
                        <span class="mono step">nächster schritt</span>
                        <p>{project.experiment.next}</p>
                      </li>
                    )}
                  </ol>
                  <dl class="meta">
                    {project.period && (
                      <div>
                        <dt class="mono">zeitraum</dt>
                        <dd>{project.period}</dd>
                      </div>
                    )}
                    <div>
                      <dt class="mono">stack</dt>
                      <dd>{project.tags.join(' · ')}</dd>
                    </div>
                  </dl>
                  <div class="links">
                    {project.caseStudy && (
                      <a class="btn btn-accent" href={project.caseStudy}>
                        case study lesen
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M5 12h14m0 0-6-6m6 6-6 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    )}
                    {[...(project.href ? [{ label: hostname(project.href), href: project.href }] : []), ...(project.links ?? [])].map((link) => (
                        <a class="btn" href={link.href} target="_blank" rel="noopener">
                          {link.label}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path
                              d="M7 17 17 7M9 7h8v8"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </a>
                      ))}
                  </div>
                </div>
                {project.href || project.caseStudy ? (
                  <a
                    class="media"
                    href={project.caseStudy ?? project.href}
                    target={project.caseStudy ? undefined : '_blank'}
                    rel={project.caseStudy ? undefined : 'noopener'}
                    data-cursor={project.caseStudy ? 'case study →' : 'ansehen ↗'}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <Image
                      src={project.image}
                      alt={project.imageAlt}
                      widths={[640, 960, 1280, 1600]}
                      sizes="(max-width: 960px) calc(100vw - 2rem), 60vw"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </a>
                ) : (
                  <div class="media">
                    <Image
                      src={project.image}
                      alt={project.imageAlt}
                      widths={[640, 960, 1280, 1600]}
                      sizes="(max-width: 960px) calc(100vw - 2rem), 60vw"
                      loading="lazy"
                    />
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
  <div class="cursor mono" aria-hidden="true">ansehen ↗</div>
</section>

<script>
  // Label folgt dem Mauszeiger über den Projektbildern (nur bei echter Maus).
  const cursor = document.querySelector<HTMLElement>('.projects .cursor');
  const media = document.querySelectorAll<HTMLElement>('.projects a.media');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cursor && finePointer) {
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;
    const follow = () => {
      cx += (x - cx) * 0.2;
      cy += (y - cy) * 0.2;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    media.forEach((el) => {
      el.addEventListener('pointerenter', (event) => {
        x = cx = event.clientX;
        y = cy = event.clientY;
        cursor.textContent = el.dataset.cursor ?? 'ansehen ↗';
        cursor.classList.add('show');
        follow();
      });
      el.addEventListener('pointermove', (event) => {
        x = event.clientX;
        y = event.clientY;
        if (!raf) raf = requestAnimationFrame(follow);
      });
      el.addEventListener('pointerleave', () => cursor.classList.remove('show'));
    });
  }
</script>

<style>
  .list {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: start;
  }

  .project:nth-child(even) .info {
    order: 2;
  }

  .num {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink-3);
    opacity: 0.55;
  }

  .title {
    margin-top: 1.25rem;
    font-stretch: 112%;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .group + .group {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .group-label {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .category {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    margin-top: 0.9rem;
    color: var(--ink-3);
  }

  .status {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
  }

  .status.live {
    border-color: var(--accent);
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* Abgeschlossene Projekte etwas zurückgenommen */
  .done .media img {
    filter: saturate(0.6);
    transition:
      filter 0.6s ease,
      transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .done .media:hover img {
    filter: none;
  }

  /* Experiment-Log: senkrechte Linie mit Markierungen */
  .experiment {
    position: relative;
    display: grid;
    gap: 1.1rem;
    margin: 2rem 0 0;
    padding: 0 0 0 1.5rem;
    list-style: none;
  }

  .experiment::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--line);
  }

  .experiment li {
    position: relative;
  }

  .experiment li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem + 1px);
    top: 0.42rem;
    width: 7px;
    height: 7px;
    border: 1px solid var(--ink-3);
    background: var(--bg);
  }

  .experiment .result::before {
    border-color: var(--accent);
    background: var(--accent);
  }

  .step {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--ink-3);
  }

  .result .step {
    color: var(--accent);
  }

  .experiment p {
    max-width: 46ch;
    color: var(--ink-2);
  }

  .result p {
    color: var(--accent);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .meta {
    display: grid;
    margin: 1.75rem 0 2rem;
    border-top: 1px solid var(--line);
  }

  .meta div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .meta dt {
    color: var(--ink-3);
  }

  .meta dd {
    margin: 0;
    font-size: 0.98rem;
  }

  .metric {
    color: var(--accent);
    font-weight: 700;
  }

  .media {
    position: sticky;
    top: 6.5rem;
    display: block;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 16 / 10;
    background: var(--bg-2);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.media:hover img {
    transform: scale(1.04);
  }

  @media (hover: hover) and (pointer: fine) {
    a.media {
      cursor: none;
    }
  }

  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 95;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.2s ease,
      scale 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cursor.show {
    opacity: 1;
    scale: 1;
  }

  @media (max-width: 960px) {
    .project {
      grid-template-columns: 1fr;
    }

    .project:nth-child(even) .info {
      order: 0;
    }

    .media {
      position: static;
      order: -1;
    }
  }
</style>
