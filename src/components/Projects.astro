---
import { Image } from 'astro:assets';
import RiseText from './RiseText.astro';
import { projects } from '../data/site';

const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, '');
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="projekte" class="section projects" aria-labelledby="projekte-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="label">ausgewählte arbeiten</p>
      <h2 id="projekte-title" class="display"><RiseText text="projekte" /></h2>
    </div>

    <ol class="list">
      {
        projects.map((project, i) => (
          <li class="project" data-reveal>
            <div class="info">
              <p class="num" aria-hidden="true">
                {pad(i + 1)}
              </p>
              <h3 class="title">{project.name}</h3>
              <p class="desc">{project.description}</p>
              <dl class="meta">
                <div>
                  <dt class="mono">kategorie</dt>
                  <dd>{project.category}</dd>
                </div>
                <div>
                  <dt class="mono">ergebnis</dt>
                  <dd>
                    <span class="metric">{project.metric.value}</span> {project.metric.label}
                  </dd>
                </div>
                {project.period && (
                  <div>
                    <dt class="mono">zeitraum</dt>
                    <dd>{project.period}</dd>
                  </div>
                )}
                <div>
                  <dt class="mono">stack</dt>
                  <dd>{project.tags.join(' · ')}</dd>
                </div>
              </dl>
              <a class="btn" href={project.href} target="_blank" rel="noopener">
                {hostname(project.href)}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M7 17 17 7M9 7h8v8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
            <a class="media" href={project.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={[640, 960, 1280, 1600]}
                sizes="(max-width: 960px) calc(100vw - 2rem), 60vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="cursor mono" aria-hidden="true">ansehen ↗</div>
</section>

<script>
  // Label folgt dem Mauszeiger über den Projektbildern (nur bei echter Maus).
  const cursor = document.querySelector<HTMLElement>('.projects .cursor');
  const media = document.querySelectorAll<HTMLElement>('.projects .media');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cursor && finePointer) {
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;
    const follow = () => {
      cx += (x - cx) * 0.2;
      cy += (y - cy) * 0.2;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    media.forEach((el) => {
      el.addEventListener('pointerenter', (event) => {
        x = cx = event.clientX;
        y = cy = event.clientY;
        cursor.classList.add('show');
        follow();
      });
      el.addEventListener('pointermove', (event) => {
        x = event.clientX;
        y = event.clientY;
        if (!raf) raf = requestAnimationFrame(follow);
      });
      el.addEventListener('pointerleave', () => cursor.classList.remove('show'));
    });
  }
</script>

<style>
  .list {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  .project:nth-child(even) .info {
    order: 2;
  }

  .num {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink-3);
    opacity: 0.55;
  }

  .title {
    margin-top: 1.25rem;
    font-stretch: 112%;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .desc {
    max-width: 44ch;
    margin-top: 1.4rem;
    color: var(--ink-2);
  }

  .meta {
    display: grid;
    margin: 2rem 0;
    border-top: 1px solid var(--line);
  }

  .meta div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .meta dt {
    color: var(--ink-3);
  }

  .meta dd {
    margin: 0;
    font-size: 0.98rem;
  }

  .metric {
    color: var(--accent);
    font-weight: 700;
  }

  .media {
    display: block;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 16 / 10;
    background: var(--bg-2);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .media:hover img {
    transform: scale(1.04);
  }

  @media (hover: hover) and (pointer: fine) {
    .media {
      cursor: none;
    }
  }

  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 95;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.2s ease,
      scale 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cursor.show {
    opacity: 1;
    scale: 1;
  }

  @media (max-width: 960px) {
    .project {
      grid-template-columns: 1fr;
    }

    .project:nth-child(even) .info {
      order: 0;
    }

    .media {
      order: -1;
    }
  }
</style>
