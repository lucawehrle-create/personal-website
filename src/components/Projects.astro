---
import SectionHeading from './SectionHeading.astro';
import ProjectVisual from './ProjectVisual.astro';
import { projects, lab } from '../data/site';

const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, '');
---

<section id="projekte" class="section" aria-labelledby="projekte-title">
  <div class="container">
    <SectionHeading index="02" label="Projekte" id="projekte-title">Dinge, die ich gebaut habe.</SectionHeading>

    <div class="grid">
      {
        projects.map((project, i) => (
          <article class="card" data-reveal style={`--delay: ${i * 0.1}s`}>
            <div class={`visual-wrap ${project.visual}`}>
              <ProjectVisual type={project.visual} />
            </div>
            <div class="body">
              <div class="meta">
                <p class="mono category">{project.category}</p>
                <p class="metric">
                  <span class="metric-value">{project.metric.value}</span>
                  <span class="metric-label">{project.metric.label}</span>
                </p>
              </div>
              <h3>
                <a href={project.href} target="_blank" rel="noopener">
                  {project.name}
                </a>
              </h3>
              <p class="description">{project.description}</p>
              <ul class="tags" aria-label="Schwerpunkte">
                {project.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
              <p class="visit" aria-hidden="true">
                {hostname(project.href)}
                <svg viewBox="0 0 24 24">
                  <path
                    d="M7 17 17 7M9 7h8v8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </p>
            </div>
          </article>
        ))
      }

      <aside class="lab" data-reveal aria-label={lab.title}>
        <p class="mono lab-label"><span class="blink" aria-hidden="true"></span>In Arbeit</p>
        <div>
          <h3>{lab.title}</h3>
          <p class="muted">{lab.text}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
    transition:
      border-color 0.25s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover {
    border-color: var(--ink-3);
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .visual-wrap {
    aspect-ratio: 16 / 10;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .visual-wrap.potato {
    background: var(--potato-bg);
  }

  .visual-wrap.focus {
    background: var(--focus-bg);
  }

  .visual-wrap :global(svg) {
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .visual-wrap :global(svg) {
    transform: scale(1.035);
  }

  .card:hover .visual-wrap.potato :global(.spud) {
    transform: rotate(-3deg);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .category {
    color: var(--ink-3);
  }

  .metric {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  h3 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    margin-bottom: 0.8rem;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:focus-visible {
    outline: none;
  }

  /* Die ganze Karte ist klickbar. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .description {
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1.6rem;
    font-weight: 600;
  }

  .visit svg {
    width: 18px;
    height: 18px;
    transition: transform 0.25s ease;
  }

  .card:hover .visit svg {
    transform: translate(3px, -3px);
  }

  .card:hover .visit {
    color: var(--accent);
  }

  .lab {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  .lab-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-3);
  }

  .blink {
    width: 9px;
    height: 16px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .lab h3 {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .lab {
      grid-template-columns: 1fr;
    }
  }
</style>
