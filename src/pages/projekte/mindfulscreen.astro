---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import { caseStudy } from '../../data/mindfulscreen';

const c = caseStudy;
const pad = (n: number) => String(n).padStart(2, '0');
// *Sternchen* markieren die grün hervorgehobenen Wörter der Instagram-Cover.
const parts = (text: string) => text.split('*').map((t, i) => ({ t, hl: i % 2 === 1 }));
---

<CaseStudy
  title="Mindfulscreen – Case Study"
  description="Mindfulscreen: eine Marke gegen Handysucht mit Website, 21-Tage-Programm, Instagram-Kanal und dem Buch „Handy aus, Leben an“."
  name={c.title}
  label={`case study · abgeschlossen · ${c.period}`}
  claim={c.claim}
  intro={c.intro}
  roles={c.roles}
  hero={c.hero}
  heroAlt={c.heroAlt}
  kpis={c.kpis}
  next={{ href: '/projekte/gemuesegruss/', label: 'gemüsegruß' }}
>
  <section class="section why" aria-labelledby="warum-title">
    <div class="container why-grid">
      <div data-reveal>
        <p class="label">warum</p>
        <h2 id="warum-title" class="visually-hidden">Warum Mindfulscreen</h2>
        <blockquote class="quote">
          {c.quote.map((line) => <p>{line}</p>)}
          <footer class="mono">– von mindfulscreen.com</footer>
        </blockquote>
      </div>
      <figure class="phone" data-reveal style="--delay: 0.1s">
        <Image src={c.website} alt={c.websiteAlt} widths={[420, 840]} sizes="(max-width: 900px) 80vw, 360px" />
      </figure>
    </div>
  </section>

  <section class="section channels-wrap" aria-labelledby="kanaele-title">
    <div class="container">
      <div class="split-head" data-reveal>
        <p class="label">vier kanäle, eine idee</p>
        <h2 id="kanaele-title">Eine Marke rund um weniger Bildschirmzeit.</h2>
      </div>
      <ol class="channels">
        {
          c.channels.map((channel, i) => (
            <li data-reveal style={`--delay: ${i * 0.08}s`}>
              <span class="mono num">{pad(i + 1)}</span>
              <h3>{channel.title}</h3>
              <p>{channel.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section paper book-section" aria-labelledby="buch-title">
    <div class="container book-grid">
      <div class="book-stage" data-reveal>
        <div class="book">
          <Image src={c.book.cover} alt={c.book.coverAlt} widths={[400, 800]} sizes="(max-width: 900px) 60vw, 340px" />
        </div>
      </div>
      <div class="book-text" data-reveal style="--delay: 0.1s">
        <p class="label">das buch</p>
        <h2 id="buch-title">{c.book.title}.</h2>
        <p class="book-sub">{c.book.subtitle}</p>
        <p class="rating">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span><strong>{c.book.rating}</strong> von 5 Sternen · {c.book.ratings} Bewertungen auf Amazon</span>
        </p>
        <p class="lead">
          Alles, was ich in Kurs und Content über Handysucht gelernt habe, in einem Buch: Schritt für Schritt zu weniger
          Bildschirmzeit – geschrieben für alle, die ihr Handy weglegen wollen, aber nicht wissen, wie.
        </p>
        {
          c.book.href && (
            <a class="btn btn-accent" href={c.book.href} target="_blank" rel="noopener">
              auf amazon ansehen ↗
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="content-title">
    <div class="container content-grid">
      <div>
        <div class="split-head" data-reveal>
          <p class="label">instagram</p>
          <h2 id="content-title">Content, der kurz innehalten lässt.</h2>
          <p class="lead">
            Auf @mindfulscreen habe ich Karussell-Posts zu Fokus, Motivation und Handysucht veröffentlicht – klare Typografie,
            schwarzer Hintergrund, ein grünes Schlüsselwort.
          </p>
        </div>
        <ul class="posts">
          {
            c.posts.map((post, i) => (
              <li class="post" data-reveal style={`--delay: ${i * 0.08}s`}>
                <span class="post-brand mono">luca wehrle</span>
                <p class="post-title">{parts(post.title).map((p) => (p.hl ? <span class="hl">{p.t}</span> : p.t))}</p>
                <p class="post-sub">{post.sub}</p>
                <span class="post-logo mono">
                  <Image src={c.logoMark} alt="" width={14} height={16} />
                  mindfulscreen
                </span>
              </li>
            ))
          }
        </ul>
        <p class="source mono">Karussell-Cover nachgebaut nach den Originalen auf Instagram.</p>
      </div>
      <figure class="phone dark" data-reveal style="--delay: 0.1s">
        <Image src={c.instagram} alt={c.instagramAlt} widths={[460, 920]} sizes="(max-width: 900px) 80vw, 360px" />
      </figure>
    </div>
  </section>

  <section class="section experiment-wrap" aria-labelledby="experiment-title">
    <div class="container">
      <div class="split-head" data-reveal>
        <p class="label">das experiment</p>
        <h2 id="experiment-title">Was ich herausfinden wollte.</h2>
      </div>
      <dl class="experiment" data-reveal>
        <div>
          <dt class="mono">hypothese</dt>
          <dd>{c.experiment.hypothesis}</dd>
        </div>
        <div>
          <dt class="mono">test</dt>
          <dd>{c.experiment.test}</dd>
        </div>
        <div class="result">
          <dt class="mono">ergebnis</dt>
          <dd>{c.experiment.result}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section learnings-wrap" aria-labelledby="learnings-title">
    <div class="container">
      <div class="split-head" data-reveal>
        <p class="label">learnings</p>
        <h2 id="learnings-title">Was ich mitgenommen habe.</h2>
      </div>
      <ol class="learnings">
        {
          c.learnings.map((item, i) => (
            <li data-reveal style={`--delay: ${i * 0.08}s`}>
              <span class="mono">{pad(i + 1)}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</CaseStudy>

<style>
  .why,
  .channels-wrap,
  .experiment-wrap,
  .learnings-wrap {
    border-top: 1px solid var(--line);
  }

  .why-grid,
  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .quote {
    margin: 1.5rem 0 0;
  }

  .quote p {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.7rem, 3.4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .quote p + p {
    margin-top: 1.25rem;
    color: var(--ink-3);
  }

  .quote p:first-child::before {
    content: '„';
    color: var(--accent);
  }

  .quote p:last-of-type::after {
    content: '“';
    color: var(--accent);
  }

  .quote footer {
    margin-top: 1.5rem;
    color: var(--ink-3);
  }

  .phone {
    margin: 0;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 40px;
    background: var(--bg-2);
    max-width: 100%;
  }

  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 31px;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem clamp(1.25rem, 2.5vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink);
  }

  .channels .num {
    color: var(--accent);
  }

  .channels h3,
  .learnings h3 {
    margin: 0.9rem 0 0.6rem;
    font-stretch: 112%;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .channels p,
  .learnings p {
    color: var(--ink-2);
  }

  /* Buch */
  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .book-stage {
    display: grid;
    place-items: center;
    perspective: 1600px;
    padding-block: 1rem;
  }

  .book {
    position: relative;
    width: min(340px, 70%);
    transform: rotateY(-16deg) rotateX(4deg);
    transform-style: preserve-3d;
    border-radius: 3px 8px 8px 3px;
    box-shadow:
      -24px 40px 60px -20px rgb(0 0 0 / 0.45),
      inset 0 0 0 1px rgb(0 0 0 / 0.08);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .book:hover {
    transform: rotateY(-4deg) rotateX(2deg);
  }

  .book img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px 8px 8px 3px;
  }

  /* Buchrücken-Schattierung und Glanz */
  .book::before,
  .book::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 3px 8px 8px 3px;
    pointer-events: none;
  }

  .book::before {
    width: 18px;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.35), rgb(255 255 255 / 0.25) 45%, rgb(0 0 0 / 0.08));
  }

  .book::after {
    background: linear-gradient(110deg, rgb(255 255 255 / 0.2), transparent 40%, transparent 75%, rgb(0 0 0 / 0.12));
  }

  .book-text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .book-sub {
    max-width: 40ch;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--ink-2);
  }

  .rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
  }

  .stars {
    color: var(--accent);
    font-size: 1.3rem;
    letter-spacing: 0.1em;
  }

  /* Instagram-Cover */
  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post {
    --ms-green: #8ed691;
    display: flex;
    flex-direction: column;
    aspect-ratio: 4 / 5;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #000;
    color: #fff;
    overflow: hidden;
  }

  .post-brand {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }

  .post-title {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .post-title .hl {
    color: var(--ms-green);
  }

  .post-sub {
    margin-top: 0.5rem;
    font-size: 0.68rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.8);
  }

  .post-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-logo img {
    width: 10px;
    height: auto;
  }

  /* Experiment */
  .experiment {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .experiment div {
    padding: 1.25rem 1.5rem 1.25rem 0;
  }

  .experiment div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .experiment dt {
    color: var(--ink-3);
  }

  .experiment dd {
    margin: 0.5rem 0 0;
    color: var(--ink-2);
    font-size: 1.05rem;
  }

  .experiment .result dt {
    color: var(--accent);
  }

  .experiment .result dd {
    color: var(--ink);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .learnings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .learnings li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .learnings .mono {
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .why-grid,
    .content-grid,
    .book-grid,
    .experiment,
    .learnings {
      grid-template-columns: 1fr;
    }

    .phone {
      width: min(360px, 88%);
      justify-self: center;
    }

    .experiment div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .channels {
      grid-template-columns: 1fr;
    }

    .posts {
      grid-template-columns: 1fr 1fr;
    }

    .post:last-child {
      display: none;
    }
  }
</style>
