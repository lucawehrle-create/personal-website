---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import ViewsChart from '../../components/ViewsChart.astro';
import MonthlyChart from '../../components/MonthlyChart.astro';
import { caseStudy, months, social, trafficSources, videos } from '../../data/gemuesegruss';

const c = caseStudy;
const pad = (n: number) => String(n).padStart(2, '0');
const de = new Intl.NumberFormat('de-DE');
const maxShare = Math.max(...trafficSources.map((t) => t.share));
const totalFollowers = social.followers.reduce((sum, f) => sum + f.count, 0);
---

<CaseStudy
  title="GemüseGruß – Case Study"
  description="Wie aus einem Meme ein Onlineshop wurde: GemüseGruß erzielte 11.700 € Umsatz mit 904 Bestellungen und über 2,8 Mio. Aufrufen auf TikTok und Instagram – ohne Werbebudget."
  name="gemüsegruß"
  label={`case study · abgeschlossen · ${c.period}`}
  claim={c.claim}
  intro={c.intro}
  roles={c.roles}
  hero={c.hero}
  heroAlt={c.heroAlt}
  kpis={c.kpis}
  next={{ href: '/projekte/mindfulscreen/', label: 'mindfulscreen' }}
>
    <section class="section" aria-labelledby="reichweite-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">reichweite</p>
          <h2 id="reichweite-title">Ein Reel. 1,1 Millionen Aufrufe.</h2>
          <p class="lead">
            Den Shop habe ich fast ausschließlich über Kurzvideos bekannt gemacht: Kartoffeln beschriften, Reaktionen zeigen,
            Grüße vorlesen. Die zehn erfolgreichsten Videos kommen zusammen auf über 2,8 Millionen Aufrufe.
          </p>
        </div>
        <div data-reveal>
          <ViewsChart videos={videos} />
          <p class="source mono">
            Quelle: Instagram-Statistik (2 Jahre) und angepinnte TikTok-Videos. Bei TikTok beschreibt der Titel das Video.
            Für die Summe zählt das gerundete „1,1 Mio.“ nur mit 1,05 Mio.
          </p>
        </div>
      </div>
    </section>

    <section class="section revenue" aria-labelledby="umsatz-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">umsatz pro monat</p>
          <h2 id="umsatz-title">Ein Reel, ein Rekordmonat.</h2>
          <p class="lead">
            Im Januar 2025 ging das Reel mit 1,1 Millionen Aufrufen online. Im selben Monat kamen 314 Bestellungen und über
            4.000 € Umsatz zusammen – mehr als ein Drittel des gesamten Umsatzes. Januar und Februar zusammen stehen für über
            60 Prozent.
          </p>
        </div>
        <div data-reveal>
          <MonthlyChart
            months={months}
            note="26.01.2025: Reel „Das gibt es wirklich“ erreicht 1,1 Mio. Aufrufe"
            noteShort="Reel mit 1,1 Mio. Aufrufen"
          />
          <p class="source mono">
            Quelle: Shopify Analytics, Dezember 2024 bis Februar 2026. Im Oktober 2025 wurden alle vier Bestellungen erstattet.
          </p>
        </div>
      </div>
    </section>

    <section class="section day" aria-labelledby="tag-title">
      <div class="container day-grid">
        <div class="day-text" data-reveal>
          <p class="label">der stärkste tag im shop</p>
          <h2 id="tag-title">44 Bestellungen an einem Tag.</h2>
          <p class="lead">
            Wenn ein Video durchstartet, merkt man es zuerst am Handy: Benachrichtigung um Benachrichtigung. An diesem Tag kamen
            über 600 € Umsatz zusammen, und über 50 Bestellungen warteten darauf, beschriftet und verschickt zu werden.
          </p>
          <dl class="stats">
            <div>
              <dt class="mono">umsatz</dt>
              <dd><span data-count>{c.bestDay.revenue}</span> <span class="delta mono">{c.bestDay.revenueDelta} zum vortag</span></dd>
            </div>
            <div>
              <dt class="mono">bestellungen</dt>
              <dd><span data-count>{c.bestDay.orders}</span> <span class="delta mono">{c.bestDay.ordersDelta} zum vortag</span></dd>
            </div>
            <div>
              <dt class="mono">conversion</dt>
              <dd>{c.bestDay.conversion}</dd>
            </div>
            <div>
              <dt class="mono">preis pro gruß</dt>
              <dd>{c.bestDay.price}</dd>
            </div>
          </dl>
        </div>
        <div class="phone" data-reveal aria-label="Bestell-Benachrichtigungen innerhalb von zwei Stunden">
          <p class="phone-head mono">benachrichtigungen</p>
          <ol class="notes">
            {
              [...c.orders].reverse().map((order, i) => (
                <li style={`--n: ${c.orders.length - 1 - i}`}>
                  <span class="note-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" fill="currentColor" />
                      <path d="M9 9V7a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                  </span>
                  <span class="note-body">
                    <span class="note-top">
                      <strong>Bestellung {order.id}</strong>
                      <span class="mono">{order.ago}</span>
                    </span>
                    <span class="note-text">13,49 €, 1 Artikel · GemüseGruß</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="phone-foot mono"><span>{c.bestDay.toPack}</span> bestellungen warten auf den versand</p>
        </div>
      </div>
    </section>

    <section class="section organic" aria-labelledby="organisch-title">
      <div class="container organic-grid">
        <div data-reveal>
          <div class="split-head">
            <p class="label">ohne werbebudget</p>
            <h2 id="organisch-title">0 € für Werbung. Alles organisch.</h2>
            <p class="lead">
              Keine Meta-Ads, keine Google-Ads, keine TikTok-Ads: Der gesamte Umsatz entstand organisch – über Kurzvideos,
              direkte Aufrufe und Suche. {de.format(totalFollowers)} Menschen folgten GemüseGruß auf TikTok und Instagram.
            </p>
          </div>
          <ul class="facts">
            {
              social.facts.map((fact) => (
                <li>
                  <span class="fact-value">{fact.value}</span>
                  <span class="fact-label">{fact.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <figure class="sources" data-reveal style="--delay: 0.1s">
          <figcaption class="mono sources-title">woher die besucher im shop kamen</figcaption>
          <ol>
            {
              trafficSources.map((source, i) => (
                <li class:list={{ top: i === 0 }}>
                  <span class="src-label">{source.label}</span>
                  <span class="src-value">{de.format(source.share)} %</span>
                  <span class="src-track" aria-hidden="true">
                    <span class="src-bar" style={`--w: ${(source.share / maxShare) * 100}%; --i: ${i}`} />
                  </span>
                  <span class="src-meta mono">{de.format(source.sessions)} Sitzungen</span>
                </li>
              ))
            }
          </ol>
          <p class="sources-follow mono">
            {social.followers.map((f) => `${f.platform}: ${de.format(f.count)} Follower`).join(' · ')}
          </p>
        </figure>
      </div>
    </section>

    <section class="section paper process" aria-labelledby="ablauf-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">so funktioniert’s</p>
          <h2 id="ablauf-title">Vom Klick zur Kartoffel im Briefkasten.</h2>
        </div>
        <ol class="steps">
          {
            c.steps.map((step, i) => (
              <li data-reveal style={`--delay: ${i * 0.08}s`}>
                <span class="mono step-num">{pad(i + 1)}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="gallery">
          {
            c.gallery.map((item, i) => (
              <figure data-reveal style={`--delay: ${i * 0.08}s`}>
                <Image src={item.image} alt={item.alt} widths={[400]} sizes="(max-width: 760px) 100vw, 33vw" />
              </figure>
            ))
          }
        </div>
        <p class="gallery-note mono">Standbilder aus den Videos auf TikTok</p>
      </div>
    </section>

    <section class="section" aria-labelledby="learnings-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">learnings</p>
          <h2 id="learnings-title">Was ich mitgenommen habe.</h2>
        </div>
        <ol class="learnings">
          {
            c.learnings.map((item, i) => (
              <li data-reveal style={`--delay: ${i * 0.08}s`}>
                <span class="mono">{pad(i + 1)}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section evidence" aria-labelledby="belege-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">belege</p>
          <h2 id="belege-title">Die Original-Screenshots.</h2>
        </div>
        <div class="shots" tabindex="0" aria-label="Screenshots, horizontal scrollbar">
          {
            c.evidence.map((item, i) => (
              <figure data-reveal style={`--delay: ${i * 0.08}s`}>
                <Image src={item.image} alt={item.alt} widths={[460, 920]} sizes="(max-width: 760px) 75vw, 30vw" />
                <figcaption class="mono">{item.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

</CaseStudy>


<style>
  .revenue,
  .organic {
    border-top: 1px solid var(--line);
  }

  /* Der stärkste Tag */
  .day {
    border-top: 1px solid var(--line);
  }

  /* Ohne Werbebudget */
  .organic-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .facts li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .facts li:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .fact-value {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .fact-label {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .sources {
    --bar: #77746e;
    margin: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg-2);
  }

  .sources-title {
    margin-bottom: 1rem;
    color: var(--ink-3);
  }

  .sources ol {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sources li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    align-items: baseline;
  }

  .src-label {
    font-weight: 600;
  }

  .src-value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .sources li:not(.top) .src-value {
    color: var(--ink-2);
  }

  .src-track {
    grid-column: 1 / -1;
    height: 14px;
  }

  .src-bar {
    display: block;
    width: max(var(--w), 3px);
    height: 100%;
    border-radius: 0 4px 4px 0;
    background: var(--bar);
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.2s + var(--i) * 80ms);
  }

  .top .src-bar {
    background: var(--accent);
  }

  :global(.js) .sources:not(:global(.is-visible)) .src-bar {
    transform: scaleX(0);
  }

  .src-meta {
    grid-column: 1 / -1;
    color: var(--ink-3);
    font-size: 0.72rem;
  }

  .sources-follow {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .day-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .day-text .label {
    margin-bottom: 1.1rem;
  }

  .day-text .lead {
    margin-top: 1.25rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 2.25rem 0 0;
    border-top: 1px solid var(--ink);
  }

  .stats div {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .stats div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .stats dt {
    color: var(--ink-3);
  }

  .stats dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .delta {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .phone {
    padding: 1.25rem 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 36px;
    background:
      radial-gradient(ellipse 90% 60% at 50% 0%, rgb(255 91 31 / 0.12), transparent 70%),
      var(--bg-2);
  }

  .phone-head,
  .phone-foot {
    padding-inline: 0.5rem;
    color: var(--ink-3);
  }

  .phone-head {
    margin-bottom: 0.9rem;
  }

  .phone-foot {
    margin-top: 0.9rem;
  }

  .phone-foot span {
    color: var(--accent);
    font-weight: 700;
  }

  .notes {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes li {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    padding: 0.8rem 0.9rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.06);
  }

  :global(.js) .phone:not(:global(.is-visible)) .notes li {
    opacity: 0;
    transform: translateY(-14px) scale(0.97);
  }

  .notes li {
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.25s + var(--n) * 0.32s);
  }

  .note-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
  }

  .note-icon svg {
    width: 20px;
    height: 20px;
  }

  .note-body {
    display: grid;
    min-width: 0;
    flex: 1;
  }

  .note-top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .note-top .mono {
    color: var(--ink-3);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .note-text {
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  /* Ablauf (helle Fläche) */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink);
  }

  .step-num {
    color: var(--accent);
  }

  .steps h3,
  .learnings h3 {
    margin: 0.9rem 0 0.6rem;
    font-stretch: 112%;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .steps p,
  .learnings p {
    color: var(--ink-2);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .gallery figure {
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 1;
  }

  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery figure:hover img {
    transform: scale(1.04);
  }

  .gallery-note {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: 0.72rem;
  }

  .learnings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .learnings li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .learnings .mono {
    color: var(--ink-3);
  }

  .evidence {
    border-top: 1px solid var(--line);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .shots figure {
    margin: 0;
  }

  .shots img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .shots figcaption {
    margin-top: 0.75rem;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .day-grid,
    .organic-grid {
      grid-template-columns: 1fr;
    }

    .steps,
    .learnings {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .shots {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }

    .shots figure {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }

    .gallery {
      grid-template-columns: 1fr 1fr;
    }

    .gallery figure:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 480px) {
    .facts {
      grid-template-columns: 1fr;
    }

    .facts li:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .stats div:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
