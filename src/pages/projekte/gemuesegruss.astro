---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import RiseText from '../../components/RiseText.astro';
import ViewsChart from '../../components/ViewsChart.astro';
import { caseStudy, videos } from '../../data/gemuesegruss';

const c = caseStudy;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="GemüseGruß – Case Study"
  description="Wie aus einem Meme ein Onlineshop wurde: GemüseGruß verschickte über 1.000 handbeschriftete Kartoffeln und erreichte über 2,8 Mio. Aufrufe auf TikTok und Instagram."
>
  <article class="case">
    <header class="section hero">
      <div class="container">
        <a class="back mono" href="/#projekte">← alle projekte</a>
        <p class="label">case study · abgeschlossen · {c.period}</p>
        <h1 class="display name" data-reveal><RiseText text="gemüsegruß" /></h1>
        <div class="intro">
          <p class="claim" data-reveal>{c.claim}</p>
          <div data-reveal style="--delay: 0.1s">
            <p class="text">{c.intro}</p>
            <ul class="roles mono">{c.roles.map((role) => <li>{role}</li>)}</ul>
          </div>
        </div>
        <div class="hero-media" data-reveal>
          <Image src={c.hero} alt={c.heroAlt} widths={[800, 1200, 1800]} sizes="(max-width: 1440px) 100vw, 1360px" loading="eager" />
        </div>
      </div>
    </header>

    <section class="kpis-wrap" aria-label="Ergebnisse in Zahlen">
      <div class="container">
        <ul class="kpis">
          {
            c.kpis.map((kpi, i) => (
              <li data-reveal style={`--delay: ${i * 0.08}s`}>
                <span class="kpi-value" data-count>
                  {kpi.display}
                </span>
                <span class="kpi-label">{kpi.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="reichweite-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">reichweite</p>
          <h2 id="reichweite-title">Ein Reel. 1,1 Millionen Aufrufe.</h2>
          <p class="lead">
            Den Shop habe ich fast ausschließlich über Kurzvideos bekannt gemacht: Kartoffeln beschriften, Reaktionen zeigen,
            Grüße vorlesen. Die zehn erfolgreichsten Videos kommen zusammen auf über 2,8 Millionen Aufrufe.
          </p>
        </div>
        <div data-reveal>
          <ViewsChart videos={videos} />
          <p class="note mono">
            Quelle: Instagram-Statistik (2 Jahre) und angepinnte TikTok-Videos. Bei TikTok beschreibt der Titel das Video.
            Für die Summe zählt das gerundete „1,1 Mio.“ nur mit 1,05 Mio.
          </p>
        </div>
      </div>
    </section>

    <section class="section day" aria-labelledby="tag-title">
      <div class="container day-grid">
        <div class="day-text" data-reveal>
          <p class="label">der stärkste tag im shop</p>
          <h2 id="tag-title">44 Bestellungen an einem Tag.</h2>
          <p class="lead">
            Wenn ein Video durchstartet, merkt man es zuerst am Handy: Benachrichtigung um Benachrichtigung. An diesem Tag kamen
            über 600 € Umsatz zusammen, und über 50 Bestellungen warteten darauf, beschriftet und verschickt zu werden.
          </p>
          <dl class="stats">
            <div>
              <dt class="mono">umsatz</dt>
              <dd><span data-count>{c.bestDay.revenue}</span> <span class="delta mono">{c.bestDay.revenueDelta} zum vortag</span></dd>
            </div>
            <div>
              <dt class="mono">bestellungen</dt>
              <dd><span data-count>{c.bestDay.orders}</span> <span class="delta mono">{c.bestDay.ordersDelta} zum vortag</span></dd>
            </div>
            <div>
              <dt class="mono">conversion</dt>
              <dd>{c.bestDay.conversion}</dd>
            </div>
            <div>
              <dt class="mono">preis pro gruß</dt>
              <dd>{c.bestDay.price}</dd>
            </div>
          </dl>
        </div>
        <div class="phone" data-reveal aria-label="Bestell-Benachrichtigungen innerhalb von zwei Stunden">
          <p class="phone-head mono">benachrichtigungen</p>
          <ol class="notes">
            {
              [...c.orders].reverse().map((order, i) => (
                <li style={`--n: ${c.orders.length - 1 - i}`}>
                  <span class="note-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" fill="currentColor" />
                      <path d="M9 9V7a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                  </span>
                  <span class="note-body">
                    <span class="note-top">
                      <strong>Bestellung {order.id}</strong>
                      <span class="mono">{order.ago}</span>
                    </span>
                    <span class="note-text">13,49 €, 1 Artikel · GemüseGruß</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="phone-foot mono"><span>{c.bestDay.toPack}</span> bestellungen warten auf den versand</p>
        </div>
      </div>
    </section>

    <section class="section paper process" aria-labelledby="ablauf-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">so funktioniert’s</p>
          <h2 id="ablauf-title">Vom Klick zur Kartoffel im Briefkasten.</h2>
        </div>
        <ol class="steps">
          {
            c.steps.map((step, i) => (
              <li data-reveal style={`--delay: ${i * 0.08}s`}>
                <span class="mono step-num">{pad(i + 1)}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="gallery">
          {
            c.gallery.map((item, i) => (
              <figure data-reveal style={`--delay: ${i * 0.08}s`}>
                <Image src={item.image} alt={item.alt} widths={[400]} sizes="(max-width: 760px) 100vw, 33vw" />
              </figure>
            ))
          }
        </div>
        <p class="gallery-note mono">Standbilder aus den Videos auf TikTok</p>
      </div>
    </section>

    <section class="section" aria-labelledby="learnings-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">learnings</p>
          <h2 id="learnings-title">Was ich mitgenommen habe.</h2>
        </div>
        <ol class="learnings">
          {
            c.learnings.map((item, i) => (
              <li data-reveal style={`--delay: ${i * 0.08}s`}>
                <span class="mono">{pad(i + 1)}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section evidence" aria-labelledby="belege-title">
      <div class="container">
        <div class="split-head" data-reveal>
          <p class="label">belege</p>
          <h2 id="belege-title">Die Original-Screenshots.</h2>
        </div>
        <div class="shots" tabindex="0" aria-label="Screenshots, horizontal scrollbar">
          {
            c.evidence.map((item, i) => (
              <figure data-reveal style={`--delay: ${i * 0.08}s`}>
                <Image src={item.image} alt={item.alt} widths={[460, 920]} sizes="(max-width: 760px) 75vw, 30vw" />
                <figcaption class="mono">{item.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <nav class="section next" aria-label="Weiter">
      <div class="container next-inner">
        <a class="next-link" href="/#projekte">
          <span class="label">weiter</span>
          <span class="display next-title">alle projekte →</span>
        </a>
      </div>
    </nav>
  </article>
</Base>

<script>
  // Zahlen zählen hoch, sobald sie ins Bild kommen (Format bleibt wie im HTML).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');

  const animate = (el: HTMLElement) => {
    const final = el.textContent?.trim() ?? '';
    const match = final.match(/[\d.,]+/);
    if (!match) return;
    const raw = match[0];
    const decimals = raw.includes(',') ? raw.split(',')[1].length : 0;
    const target = parseFloat(raw.replace(/\./g, '').replace(',', '.'));
    const format = new Intl.NumberFormat('de-DE', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
    const start = performance.now();
    const duration = 1400;
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 4);
      el.textContent = final.replace(raw, format.format(target * eased));
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = final;
    };
    requestAnimationFrame(step);
  };

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .hero {
    padding-top: clamp(7rem, 14vw, 10rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .name {
    margin-top: 1.25rem;
    font-size: clamp(2.2rem, 11.8vw, 12rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .claim {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.6rem, 3.2vw, 2.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .text {
    color: var(--ink-2);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .roles li {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
  }

  .hero-media {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 16 / 9;
    max-width: 100%;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .kpis-wrap {
    border-block: 1px solid var(--line);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kpis li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 1.5rem clamp(1.75rem, 3.5vw, 2.75rem) 0;
  }

  .kpis li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .kpi-value {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .kpis li:first-child .kpi-value {
    color: var(--accent);
  }

  .kpi-label {
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .split-head {
    display: grid;
    gap: 1.1rem;
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  h2 {
    font-stretch: 112%;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .lead {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  .note {
    max-width: 80ch;
    margin-top: 1.25rem;
    color: var(--ink-3);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  /* Der stärkste Tag */
  .day {
    border-top: 1px solid var(--line);
  }

  .day-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .day-text .label {
    margin-bottom: 1.1rem;
  }

  .day-text .lead {
    margin-top: 1.25rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 2.25rem 0 0;
    border-top: 1px solid var(--ink);
  }

  .stats div {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .stats div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .stats dt {
    color: var(--ink-3);
  }

  .stats dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .delta {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .phone {
    padding: 1.25rem 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 36px;
    background:
      radial-gradient(ellipse 90% 60% at 50% 0%, rgb(255 91 31 / 0.12), transparent 70%),
      var(--bg-2);
  }

  .phone-head,
  .phone-foot {
    padding-inline: 0.5rem;
    color: var(--ink-3);
  }

  .phone-head {
    margin-bottom: 0.9rem;
  }

  .phone-foot {
    margin-top: 0.9rem;
  }

  .phone-foot span {
    color: var(--accent);
    font-weight: 700;
  }

  .notes {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes li {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    padding: 0.8rem 0.9rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.06);
  }

  :global(.js) .phone:not(:global(.is-visible)) .notes li {
    opacity: 0;
    transform: translateY(-14px) scale(0.97);
  }

  .notes li {
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.25s + var(--n) * 0.32s);
  }

  .note-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
  }

  .note-icon svg {
    width: 20px;
    height: 20px;
  }

  .note-body {
    display: grid;
    min-width: 0;
    flex: 1;
  }

  .note-top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .note-top .mono {
    color: var(--ink-3);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .note-text {
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  /* Ablauf (helle Fläche) */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink);
  }

  .step-num {
    color: var(--accent);
  }

  .steps h3,
  .learnings h3 {
    margin: 0.9rem 0 0.6rem;
    font-stretch: 112%;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .steps p,
  .learnings p {
    color: var(--ink-2);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .gallery figure {
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 1;
  }

  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery figure:hover img {
    transform: scale(1.04);
  }

  .gallery-note {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: 0.72rem;
  }

  .learnings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .learnings li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .learnings .mono {
    color: var(--ink-3);
  }

  .evidence {
    border-top: 1px solid var(--line);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .shots figure {
    margin: 0;
  }

  .shots img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .shots figcaption {
    margin-top: 0.75rem;
    color: var(--ink-3);
  }

  .next {
    border-top: 1px solid var(--line);
  }

  .next-link {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }

  .next-title {
    font-size: clamp(2.6rem, 9vw, 8rem);
    transition: color 0.3s ease;
  }

  .next-link:hover .next-title {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .intro,
    .day-grid {
      grid-template-columns: 1fr;
    }

    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .kpis li + li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .kpis li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .steps,
    .learnings {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .shots {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }

    .shots figure {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }

    .gallery {
      grid-template-columns: 1fr 1fr;
    }

    .gallery figure:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 480px) {
    .kpis {
      grid-template-columns: 1fr;
    }

    .kpis li,
    .kpis li + li {
      padding-left: 0;
      border-left: 0;
    }

    .kpis li + li {
      border-top: 1px solid var(--line);
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .stats div:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
