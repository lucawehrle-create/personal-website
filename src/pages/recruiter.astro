---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import portrait from '../assets/portrait.jpg';
import { about, career, earlier, languages, projects, site, toolboxGroups } from '../data/site';
import { logos } from '../data/logos';

const updated = new Date().toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
const pad = (n: number) => String(n).padStart(2, '0');
const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, '');

const facts = [
  { value: 'B.Sc.', label: 'Betriebswirtschaftslehre an der Universität Mannheim – abgeschlossen', accent: true },
  { value: '1.000+', label: 'Bestellungen mit GemüseGruß, 2,8 Mio. Aufrufe – ohne Werbebudget' },
  { value: '3', label: 'eigene Produkte gestartet: App, Onlineshop, Buch' },
  { value: 'C1', label: 'Englisch, Auslandssemester in Schweden' },
];

// Was gerade läuft: Studium und Jobs mit „heute“
const current = [...career.education, ...career.experience].filter((entry) => entry.period.includes('heute'));
const openTo = ['Product', 'BizOps', 'Founder Associate'];

// Zeitstrahl: Gründungen stehen bei den Projekten, nicht doppelt bei der Praxis.
const projectNames = projects.map((project) => project.name);
const timeline = [
  { title: 'bildung', rows: career.education.map((e) => ({ label: e.short ?? e.role, period: e.period })) },
  {
    title: 'praxis',
    rows: career.experience
      .filter((e) => !projectNames.includes(e.org))
      .map((e) => ({ label: e.short ?? `${e.role} · ${e.org}`, period: e.period })),
  },
  {
    title: 'eigene projekte',
    rows: projects.flatMap((p) => (p.period ? [{ label: p.name, period: p.period }] : [])),
  },
  { title: 'engagement', rows: career.engagement.map((e) => ({ label: e.short ?? e.role, period: e.period })) },
];


// Sprachniveau als Balken: sechs Stufen (A1 bis C2), Muttersprache voll.
const levels: Record<string, number> = { Muttersprache: 6, C2: 6, C1: 5, B2: 4, B1: 3, A2: 2, A1: 1, Grundkenntnisse: 1 };
---

<Base
  title="Recruiter-Modus"
  description="Luca Wehrle auf einen Blick: Werdegang, Projekte, Skills und Kontakt – kompakt für Recruiter."
  recruiter
>
  <div class="container rec">
    <div class="toolbar">
      <a class="mode mono" href="/" aria-label="Recruiter-Modus ausschalten und zur kreativen Version wechseln">
        <span class="switch" aria-hidden="true"><span></span></span>
        recruiter-modus an
        <span class="hint">· zur kreativen version</span>
      </a>
      <div class="tools">
        <a class="btn" href={`mailto:${site.email}`}>e-mail</a>
        <button class="btn print" type="button" hidden>als pdf speichern</button>
      </div>
    </div>

    <div class="top">
      <header class="card profile">
        <div class="id">
          <Image src={portrait} alt="Porträt von Luca Wehrle" width={240} height={240} class="photo" loading="eager" />
          <div>
            <p class="label">auf einen blick</p>
            <h1>{site.name}</h1>
          </div>
        </div>
        <p class="role">Product Builder · B.Sc. BWL, Universität Mannheim · Master in Trier</p>
        <dl class="quick">
          <div>
            <dt class="mono">aktuell</dt>
            <dd>
              {
                current.map((entry) => (
                  <span class="current">
                    {entry.role} · {entry.org}
                  </span>
                ))
              }
            </dd>
          </div>
          <div>
            <dt class="mono">offen für</dt>
            <dd>
              <ul class="pills">{openTo.map((item) => <li>{item}</li>)}</ul>
            </dd>
          </div>
          <div>
            <dt class="mono">standort</dt>
            <dd>{site.location}, DE</dd>
          </div>
        </dl>
        <div class="cta">
          <a class="btn btn-accent" href={`mailto:${site.email}`}>e-mail schreiben</a>
          <a class="btn" href={site.linkedin} target="_blank" rel="noopener">linkedin ↗</a>
          <a class="btn" href={site.instagram} target="_blank" rel="noopener">instagram ↗</a>
        </div>
        <p class="print-contact mono">
          {site.email} · linkedin.com/in/luca-wehrle · instagram {site.instagramHandle}
        </p>
      </header>

      <ul class="facts">
        {
          facts.map((fact) => (
            <li class:list={['card', 'fact', { accent: fact.accent }]}>
              <span class="value">{fact.value}</span>
              <span class="fact-label">{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <section class="card" aria-labelledby="zeitstrahl-title" data-reveal>
      <div class="card-head">
        <h2 id="zeitstrahl-title" class="label">werdegang auf einen blick</h2>
        <ul class="legend mono">
          <li><span class="swatch now"></span>läuft gerade</li>
          <li><span class="swatch"></span>abgeschlossen</li>
          <li><span class="swatch fuzzy"></span>monat offen</li>
        </ul>
      </div>
      <Timeline groups={timeline} />
    </section>

    <div class="columns">
      <div class="col">
        <section class="card" aria-labelledby="erfahrung-title">
          <div class="card-head">
            <h2 id="erfahrung-title" class="label">erfahrung</h2>
            <span class="mono count">{pad(career.experience.length)}</span>
          </div>
          <ol class="entries">
            {
              career.experience.map((entry) => {
                const project = projects.find((p) => p.name === entry.org);
                const logo = logos[entry.org];
                const links = project
                  ? [
                      ...(project.caseStudy ? [{ label: 'case study →', href: project.caseStudy, external: false }] : []),
                      ...(project.href ? [{ label: `${hostname(project.href)} ↗`, href: project.href, external: true }] : []),
                      ...(project.links ?? []).map((l) => ({ label: `${l.label.toLowerCase()} ↗`, href: l.href, external: true })),
                    ]
                  : [];
                return (
                  <li class:list={{ 'has-logo': logo }}>
                    <p class="mono period">{entry.period}</p>
                    {logo && (
                      <span class:list={['logo', { pad: logo.pad, framed: logo.bg === '#fff' }]} style={`--logo-bg: ${logo.bg}`}>
                        <img src={logo.src.src} alt={`Logo ${entry.org}`} width="40" height="40" loading="lazy" decoding="async" />
                      </span>
                    )}
                    <div>
                      <p class="entry-role">
                        {entry.role}
                        {project && <span class:list={['pill', project.status]}>{project.status}</span>}
                      </p>
                      <p class="entry-org">
                        {entry.org}
                        {entry.place && ` · ${entry.place}`}
                      </p>
                      {entry.points && (
                        <ul class="points">
                          {entry.points.map((point) => (
                            <li>{point}</li>
                          ))}
                        </ul>
                      )}
                      {links.length > 0 && (
                        <p class="p-links mono">
                          {links.map((link) => (
                            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
                              {link.label}
                            </a>
                          ))}
                        </p>
                      )}
                    </div>
                  </li>
                );
              })
            }
          </ol>
          <h3 class="sub mono">frühere stationen</h3>
          <ul class="entries compact">
            {
              earlier.map((item) => (
                <li>
                  <p class="mono period">{item.period}</p>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <div class="col">
        {
          [
            { title: 'bildung', entries: career.education },
            { title: 'engagement', entries: career.engagement },
          ].map((section) => (
            <section class="card">
              <div class="card-head">
                <h2 class="label">{section.title}</h2>
                <span class="mono count">{pad(section.entries.length)}</span>
              </div>
              <ol class="entries">
                {section.entries.map((entry) => (
                  <li class:list={{ 'has-logo': logos[entry.org] }}>
                    <p class="mono period">{entry.period}</p>
                    {logos[entry.org] && (
                      <span
                        class:list={['logo', { pad: logos[entry.org].pad, framed: logos[entry.org].bg === '#fff' }]}
                        style={`--logo-bg: ${logos[entry.org].bg}`}
                      >
                        <img src={logos[entry.org].src.src} alt={`Logo ${entry.org}`} width="40" height="40" loading="lazy" decoding="async" />
                      </span>
                    )}
                    <div>
                      <p class="entry-role">
                        {entry.role}
                        {entry.badge && <span class="pill badge">{entry.badge}</span>}
                      </p>
                      <p class="entry-org">
                        {entry.org}
                        {entry.place && ` · ${entry.place}`}
                      </p>
                      {entry.points && (
                        <ul class="points">
                          {entry.points.map((point) => (
                            <li>{point}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }

        <section class="card" aria-labelledby="skills-title">
          <div class="card-head">
            <h2 id="skills-title" class="label">skills &amp; sprachen</h2>
          </div>
          <dl class="skills">
            {
              toolboxGroups.map((group) => (
                <div>
                  <dt class="mono">{group.title}</dt>
                  <dd>
                    <ul class="chips">
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
          <h3 class="sub mono">sprachen</h3>
          <ul class="langs">
            {
              languages.map((language) => (
                <li>
                  <span class="lang">{language.name}</span>
                  <span class="meter" aria-hidden="true">
                    {Array.from({ length: 6 }, (_, i) => (
                      <span class:list={{ on: i < (levels[language.level] ?? 0) }} />
                    ))}
                  </span>
                  <span class="mono level">{language.level}</span>
                </li>
              ))
            }
          </ul>
          <h3 class="sub mono">interessen</h3>
          <ul class="chips">{about.interests.map((item) => <li>{item}</li>)}</ul>
        </section>
      </div>
    </div>

    <p class="updated mono">Stand: {updated} · Die ausführliche Version gibt es unter {site.url.replace('https://', '')}</p>
  </div>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>('.print');
  if (button && typeof window.print === 'function') {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  }
</script>

<style>
  .rec {
    --card: #fbfaf7;
    --gap: clamp(0.75rem, 1.4vw, 1rem);
    padding-block: clamp(1rem, 3vw, 1.75rem) clamp(4rem, 8vw, 6rem);
  }

  /* ---------- Leiste oben ---------- */

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--gap);
  }

  .tools {
    display: flex;
    gap: 0.5rem;
  }

  .mode {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block: -0.6rem;
    padding-block: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .hint {
    color: var(--ink-3);
    transition: color 0.2s ease;
  }

  .mode:hover .hint {
    color: var(--accent);
  }

  .switch {
    position: relative;
    width: 32px;
    height: 18px;
    border-radius: 999px;
    background: var(--accent);
  }

  .switch span {
    position: absolute;
    top: 3px;
    left: 17px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    transition: transform 0.25s ease;
  }

  .mode:hover .switch span {
    transform: translateX(-3px);
  }

  .print[hidden] {
    display: none;
  }

  /* ---------- Karten ---------- */

  .card {
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  h2.label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .count {
    color: var(--ink-3);
    font-size: 0.75rem;
  }

  /* ---------- Profil + Kennzahlen ---------- */

  .top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gap);
    margin-bottom: var(--gap);
  }

  /* Dunkle Profilkarte im Look der kreativen Version (Punktraster) */
  .profile {
    --bg: #111112;
    --bg-2: #1b1b1d;
    --ink: #f2f0eb;
    --ink-2: #b9b6ae;
    --ink-3: #8d8a84;
    --line: #2e2e31;
    --accent: #ff5b1f;
    --on-accent: #0d0d0e;
    display: grid;
    align-content: start;
    gap: 1.25rem;
    border-color: var(--bg);
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.07) 1px, transparent 0) 0 0 / 14px 14px,
      var(--bg);
    color: var(--ink);
  }

  .id {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .photo {
    flex: none;
    width: clamp(84px, 11vw, 128px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 18px;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--accent);
  }

  h1 {
    margin-top: 0.5rem;
    font-stretch: 125%;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .role {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--ink-2);
  }

  .quick {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .quick div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .quick dt {
    color: var(--ink-3);
    font-size: 0.75rem;
  }

  .quick dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
  }

  .current::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.1em;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pills li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.92rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .print-contact {
    display: none;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    container-type: inline-size;
  }

  /* Zahl skaliert mit der Kachel und bricht nie um */
  .value {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: min(3.4rem, 26cqw);
    white-space: nowrap;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .fact-label {
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .fact.accent {
    border-color: var(--accent);
    background: var(--accent);
  }

  .fact.accent .value,
  .fact.accent .fact-label {
    color: #111112;
  }

  /* ---------- Zeitstrahl ---------- */

  .legend {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: var(--ink-2);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .swatch {
    width: 14px;
    height: 8px;
    border-radius: 2px;
    background: #8f8b82;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .swatch.now {
    background: var(--accent);
  }

  .swatch.fuzzy {
    background: linear-gradient(to right, rgb(143 139 130 / 0.15), #8f8b82);
  }

  .card :global(.timeline) {
    margin-top: 1.25rem;
  }

  /* ---------- Details ---------- */

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gap);
    margin-top: var(--gap);
    align-items: start;
  }

  .col {
    display: grid;
    gap: var(--gap);
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entries > li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }

  .entries > li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  /* Logo links neben Titel und Organisation */
  .entries > li.has-logo {
    grid-template-columns: 9rem 40px minmax(0, 1fr);
    column-gap: 0.9rem;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--logo-bg);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .logo.framed {
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo.pad img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .pill.badge {
    border-color: var(--accent);
    background: var(--accent);
    color: #111112;
  }

  /* Titel und Status-Pille umbrechen gemeinsam, statt in die Logo-Spalte zu ragen */
  .entry-role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }

  .entry-role .pill {
    font-weight: 400;
    white-space: nowrap;
  }

  .sub {
    margin: 1.75rem 0 0;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--ink-3);
  }

  .langs + .sub {
    margin-bottom: 1rem;
  }

  .entries.compact > li {
    padding: 0.6rem 0;
    color: var(--ink-2);
  }

  .period {
    padding-top: 0.15rem;
    font-size: 0.78rem;
    color: var(--accent);
  }

  .compact .period {
    color: var(--ink-3);
  }

  .entry-role {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .entry-org {
    color: var(--ink-2);
  }

  .points {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    color: var(--ink-3);
    font-size: 0.93rem;
  }

  .pill {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
  }

  .pill.live {
    border-color: var(--accent);
    color: var(--accent);
  }

  .p-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
  }

  .p-links a {
    display: inline-block;
    margin-block: -0.45rem;
    padding-block: 0.45rem;
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  /* Skills */
  .skills {
    display: grid;
    gap: 0.9rem;
    margin: 1rem 0 0;
  }

  .skills dt {
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .skills dd {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card > .chips {
    margin-top: 1rem;
  }

  .chips li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.88rem;
    color: var(--ink);
  }

  /* Sprachen */
  .langs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .langs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 8.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .langs li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .meter {
    display: flex;
    gap: 3px;
  }

  .meter span {
    width: 12px;
    height: 6px;
    border-radius: 2px;
    background: var(--line);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .meter .on {
    background: var(--ink);
  }

  .level {
    font-size: 0.72rem;
    color: var(--ink-3);
    text-align: right;
  }

  .updated {
