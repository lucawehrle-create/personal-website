---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" noindex>
  <section class="container not-found">
    <p class="label">fehler 404</p>
    <h1 class="display">nicht<br />gefunden.</h1>
    <p class="text">Diese Seite ist wohl noch im Lab – oder sie hat den Realitätscheck nicht bestanden.</p>
    <a class="btn btn-accent" href="/">zur startseite</a>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: 2rem;
    justify-items: start;
    align-content: center;
    min-height: 100svh;
    padding-block: 8rem 6rem;
  }

  h1 {
    font-size: clamp(3.4rem, 12vw, 11rem);
  }

  .text {
    max-width: 40ch;
    font-size: 1.15rem;
    color: var(--ink-2);
  }
</style>
